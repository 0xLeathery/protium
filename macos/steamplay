        os.makedirs(HOME_DIR, exist_ok=True)
        write_file(HIRES, json.dumps({"all": everything, "games": {str(k): v for k, v in sorted(games.items())}}, indent=1) + "\n")
    words = {"auto": "automatic (on when the main screen is HiDPI)", "on": "on", "off": "off"}
    if appid is not None:
        print("Full resolution for app %d: %s" % (appid, words[games[appid]] if appid in games else "as for every game"))
    print("Full resolution in games: %s" % words[everything])
    for game, value in sorted(games.items()):
        if game != appid:
            print("  app %d: %s" % (game, value))
    if state:
        print("This applies to games started from now on.")
    return 0


