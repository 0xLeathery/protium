# ---------------------------------------------------------------- symbolic links of Mac builds

def depot_links(path):
    """(file name, link target) of every symbolic link in a depot manifest of Steam's depotcache:
    sections of magic, length and a protobuf message; in the payload section each file is
    field 1, with its name in field 1 and, for a link, the target in field 7."""
    def varint(data, pos):
        value = shift = 0
        while True:
            byte = data[pos]
            pos += 1
            value |= (byte & 0x7f) << shift
            shift += 7
            if byte < 0x80:
                return value, pos

    def fields(data):
        pos = 0
        while pos < len(data):
            key, pos = varint(data, pos)
            kind = key & 7
            if kind == 0:
                value, pos = varint(data, pos)
            elif kind == 2:
                size, pos = varint(data, pos)
                value = data[pos:pos + size]
                pos += size
            elif kind in (1, 5):
                size = 8 if kind == 1 else 4
                value = data[pos:pos + size]
                pos += size
            else:
                raise ValueError("unknown protobuf wire type %d" % kind)
            yield key >> 3, value

    with open(path, "rb") as f:
        data = f.read()
    links, pos = [], 0
    while pos + 8 <= len(data):
        magic, size = struct.unpack_from("<II", data, pos)
        pos += 8
        if magic == 0x71F617D0:
            for field, entry in fields(data[pos:pos + size]):
                if field != 1:
                    continue
                parts = dict((n, v) for n, v in fields(entry) if n in (1, 7) and isinstance(v, bytes))
                if parts.get(7):
                    links.append((parts.get(1, b"").decode("utf-8"), parts[7].decode("utf-8")))
        pos += size
    return links


def restore_links(appid):
    """Makes the symbolic links of an installed game's depots that are missing in its folder.
    Returns (made, problems)."""
    made, problems = [], []
    for lib in libraries():
        manifest = os.path.join(lib, "steamapps", "appmanifest_%d.acf" % appid)
        if not os.path.isfile(manifest):
            continue
        with open(manifest, encoding="utf-8", errors="replace") as f:
            state = vdf_block(vdf_parse(f.read()), ["AppState"])
        installdir = next((v for k, v in state if k == "installdir" and isinstance(v, str)), None)
        if not installdir:
            continue
        root = os.path.realpath(os.path.join(lib, "steamapps", "common", installdir))
        for depot, info in vdf_block(state, ["InstalledDepots"]):
            gid = next((v for k, v in info if k == "manifest" and isinstance(v, str)), None) if isinstance(info, list) else None
            path = os.path.join(STEAM_ROOT, "depotcache", "%s_%s.manifest" % (depot, gid))
            if not gid or not os.path.isfile(path):
                continue
            try:
                links = depot_links(path)
            except (OSError, ValueError, IndexError, struct.error) as e:
                problems.append("depot %s: %s" % (depot, e))
                continue
            for name, target in links:
                link = os.path.normpath(os.path.join(root, name.replace("\\", "/")))
                parent = os.path.realpath(os.path.dirname(link))
                # a link goes inside the game's folder and nowhere else, whatever a manifest says
                if not (parent + os.sep).startswith(root + os.sep) and parent != root:
                    problems.append("%s is outside %s" % (name, root))
                elif not os.path.lexists(link) and os.path.isdir(parent):
                    try:
                        os.symlink(target, link)
                        made.append(link)
                    except OSError as e:
                        problems.append("%s: %s" % (link, e))
    return made, problems


def cmd_links(appids):
    if not appids:
        mapped = current_mapping()
        appids = [a for a, _, _, _ in installed_apps() if mapped.get(a) == NATIVE]
    status = 0
    for appid in appids:
        made, problems = restore_links(appid)
        for p in problems:
            print("PROBLEM: %d: %s" % (appid, p))
        print("%d: %d link(s) made%s" % (appid, len(made), "".join("\n    " + m for m in made)))
        status = status or (1 if problems else 0)
    return status


# ---------------------------------------------------------------- install scripts

# What Steam for Windows, and Steam for Linux through Proton, does before a game's first start and
# Mac Steam never does: the game's install scripts (the "InstallScripts" of its manifest, VDF
# files in its folder) name registry values to write and installers to run once, such as the
# Vulkan runtime Red Dead Redemption 2 loads its overlay through, or the PlayStation runtime The
# Last of Us Part II asks for. Without them such a game starts and then waits or complains.

INSTALLSCRIPT_TIMEOUT = 900


def install_scripts(appid):
    """(game folder, [script path...]) of an installed game, or (None, [])."""
    for lib in libraries():
        manifest = os.path.join(lib, "steamapps", "appmanifest_%d.acf" % appid)
        if not os.path.isfile(manifest):
            continue
        with open(manifest, encoding="utf-8", errors="replace") as f:
            state = vdf_block(vdf_parse(f.read()), ["AppState"])
        installdir = next((v for k, v in state if k == "installdir" and isinstance(v, str)), None)
        if not installdir:
            continue
        root = os.path.realpath(os.path.join(lib, "steamapps", "common", installdir))
        scripts = []
        for _, rel in vdf_block(state, ["InstallScripts"]):
            path = os.path.normpath(os.path.join(root, rel.replace("\\", "/"))) if isinstance(rel, str) else ""
            # a script is a file inside the game's folder and nowhere else, whatever a manifest says
            if path.startswith(root + os.sep) and os.path.isfile(path) and path not in scripts:
                scripts.append(path)
        return root, scripts
    return None, []


def windows_path(path):
    """A host path as Wine's Z: drive has it."""
    return "Z:" + path.replace("/", "\\")


def command_words(command):
    """A Windows command line in words: split at blanks outside double quotes, quotes dropped."""
    words, word, quoted, any_ = [], "", False, False
    for c in command:
        if c == '"':
            quoted, any_ = not quoted, True
        elif c in " \t" and not quoted:
            if word or any_:
                words.append(word)
            word, any_ = "", False
        else:
            word += c
    if word or any_:
        words.append(word)
    return words


def install_script_steps(root, scripts):
    """The steps the scripts ask for, in order: ("reg", key, name, type, data) and
    ("run", done key, done name, done value, program, [argument...])."""
    variables = {
        "installdir": windows_path(root),
        "rootdrive": "C:",
        "steampath": "C:\\Program Files (x86)\\Steam",
        "windir": "C:\\windows",
        "user_mydocs": "C:\\users\\steamuser\\Documents",
        "appdata": "C:\\users\\steamuser\\AppData\\Roaming",
        "localappdata": "C:\\users\\steamuser\\AppData\\Local",
        "allusersprofile": "C:\\ProgramData",
    }

    def expand(text):
        return re.sub(r"%(\w+)%", lambda m: variables.get(m.group(1).lower(), m.group(0)), text)

    def get(pairs, name):
        return next((v for k, v in pairs if k.lower() == name and isinstance(v, str)), None)

    steps = []
    for script in scripts:
        with open(script, encoding="utf-8", errors="replace") as f:
            top = vdf_parse(f.read())
        body = next((v for k, v in top if k and k.lower() == "installscript" and isinstance(v, list)), [])
        for section, content in body:
            if not isinstance(content, list):
                continue
            if section.lower() == "registry":
                for key, kinds in content:
                    for kind, values in kinds if isinstance(kinds, list) else []:
                        # per-language blocks hold the same kinds one level down; English will do
                        if isinstance(values, list) and kind.lower() not in ("string", "dword"):
                            continue
                        for name, data in values if isinstance(values, list) else []:
                            if isinstance(data, str):
                                steps.append(("reg", key, name, "REG_DWORD" if kind.lower() == "dword" else "REG_SZ", expand(data)))
            elif section.lower() == "run process":
                for name, entry in content:
                    if not isinstance(entry, list):
                        continue
                    wants = next((v for k, v in entry if k.lower() == "requirement_os" and isinstance(v, list)), [])
                    if get(wants, "is64bitwindows") == "0":
                        continue
                    done_key = get(entry, "hasrunkey") or "HKEY_LOCAL_MACHINE\\Software\\Valve\\Steam\\Apps\\%d" % 0
                    done_value = get(entry, "minimumhasrunvalue") or "1"
                    number = 1
                    while get(entry, "process %d" % number):
                        program = expand(get(entry, "process %d" % number))
                        arguments = command_words(expand(get(entry, "command %d" % number) or ""))
                        steps.append(("run", done_key, name if number == 1 else "%s %d" % (name, number),
                                      done_value, program, arguments))
                        number += 1
    return steps


def cmd_installscript(appid, dry_run, again, mark_done):
    root, scripts = install_scripts(appid)
    if root is None:
        die("app %d is not installed" % appid)
    steps = install_script_steps(root, scripts)
    steps = [("run", s[1].replace("\\Apps\\0", "\\Apps\\%d" % appid)) + s[2:] if s[0] == "run" else s for s in steps]
    if dry_run:
        for step in steps:
            print("\t".join(str(x) if not isinstance(x, list) else " ".join(x) for x in step))
        print("%d: %d step(s) in %d install script(s)" % (appid, len(steps), len(scripts)))
        return 0
    if not steps:
        return 0
    prefix, wine = os.environ.get("WINEPREFIX"), os.environ.get("STEAMPLAY_WINE")
    if not prefix or not os.path.isdir(prefix) or not wine or not os.access(wine, os.X_OK):
        die("installscript needs WINEPREFIX (the game's prefix) and STEAMPLAY_WINE (the wine to run) set")
    stamps = os.path.join(prefix, "steamplay-installscripts.txt")
    done = set()
    if os.path.isfile(stamps) and not again:
        with open(stamps, encoding="utf-8") as f:
            done = set(f.read().splitlines())

    def run(words, cwd=None):
        try:
            return subprocess.run([wine] + words, cwd=cwd, timeout=INSTALLSCRIPT_TIMEOUT,
                                  stdin=subprocess.DEVNULL).returncode
        except subprocess.TimeoutExpired:
            return None

    def reg_add(key, name, kind, data):
        for view in ("/reg:64", "/reg:32"):
            run(["reg", "add", key, "/v", name, "/t", kind, "/d", data, "/f", view])

    status = 0
    for step in steps:
        stamp = "\t".join(step[:4]) if step[0] == "run" else "\t".join(step)
        if stamp in done:
            continue
        if step[0] == "reg":
            _, key, name, kind, data = step
            if not mark_done:
                print("install script: %s\\%s = %s" % (key, name, data), flush=True)
                reg_add(key, name, kind, data)
        else:
            _, done_key, name, done_value, program, arguments = step
            if not mark_done:
                host = program[2:].replace("\\", "/") if program[:2].upper() == "Z:" else None
                if host and not os.path.isfile(host):
                    print("install script: %s: no %s" % (name, program), flush=True)
                    status = 1
                    continue
                print("install script: %s: %s %s" % (name, program, " ".join(arguments)), flush=True)
                words = [program] + arguments
                if program.lower().endswith((".bat", ".cmd")):
                    words = ["cmd", "/c"] + words
                code = run(words, cwd=os.path.dirname(host) if host else None)
                # Steam counts a step as done whatever its installer returned (3010, "restart
                # needed", is common), and so does this; one that never ends is stopped
                print("install script: %s: %s" % (name, "stopped after %d s" % INSTALLSCRIPT_TIMEOUT if code is None
                                                  else "exit %d" % code), flush=True)
                if code is None:
                    status = 1
            reg_add(done_key, name, "REG_DWORD", done_value)
        done.add(stamp)
        with open(stamps, "a", encoding="utf-8") as f:
            f.write(stamp + "\n")
    return status


# ---------------------------------------------------------------- the guard

def session_lines():
    """The first lines Steam's compatibility log has of the client's latest start, or []."""
    path = os.path.join(STEAM_ROOT, "logs", "compat_log.txt")
    marker = b"] Client version:"
    try:    # the log runs to megabytes a start: find the last start from the end, then read its head
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            end = pos = f.tell()
            at = -1
            while pos > 0 and at < 0 and end - pos < (256 << 20):
                step = min(pos, 1 << 20)
                pos -= step
                f.seek(pos)
                chunk = f.read(step + len(marker))
                at = chunk.rfind(marker)
            if at < 0:
                return []
            f.seek(max(0, pos + at - 22))
            head = f.read(65536).decode("utf-8", "replace")
    except OSError:
        return []
    return head[head.index("["):].splitlines() if "[" in head else []


def session_state(session=None):
    """What Steam's compatibility log says of the client's latest start: "ok" (our tools are
    registered), "ignored" (they were turned down: Steam's platform is not linux), "no-tools"
    (they were not there when it started), or "unknown" (too early to say, or no log)."""
    if session is None:
        session = session_lines()
    if not session:
        return "unknown"
    if any("Ignoring tool %s " % t in l for l in session for t in TOOLS):
        return "ignored"
    if all(any("Registering tool %s," % t in l for l in session) for t in TOOLS):
        return "ok"
    try:    # the tools are read in the first second: give a start five before judging
        began = time.mktime(time.strptime(session[0][1:20], "%Y-%m-%d %H:%M:%S"))
    except ValueError:
        return "unknown"
    return "no-tools" if time.time() - began > 5 else "unknown"


def guard_log(message):
    line = "%s %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), message)
    try:
        os.makedirs(os.path.dirname(GUARD_LOG), exist_ok=True)
        with open(GUARD_LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass
    print(line)


GUARD_STOPS = os.path.join(HOME_DIR, "guard-stops.json")
GUARD_TRIES, GUARD_WINDOW = 3, 600


def guard_gave_up():
    """The start of the Steam session the guard gave up on (its first log line), or None."""
    return json_file(GUARD_STOPS, {}).get("gave_up")


def guard_may_stop(session):
    """Whether the guard may stop this Steam session, which runs without Steam Play. It may
    GUARD_TRIES times in GUARD_WINDOW seconds. When a Steam turns the tools down at every start,
    stopping it again only keeps the player from Steam: the guard then says so once, lets this
    session run, and looks again at the next. Counts the stop it allows."""
    start = session[0] if session else ""
    state = json_file(GUARD_STOPS, {})
    if state.get("gave_up") == start and start:
        return False
    stops = [t for t in state.get("stops", []) if isinstance(t, (int, float)) and 0 <= time.time() - t < GUARD_WINDOW]
    gave_up = len(stops) >= GUARD_TRIES
    if gave_up:
        state = {"stops": stops, "gave_up": start}
        guard_log("PROBLEM: Steam started without Protium's tools %d times in %d minutes. Leaving it running. "
                  "Open Protium and press Repair." % (GUARD_TRIES, GUARD_WINDOW // 60))
        if not (os.environ.get("STEAMPLAY_FAKE_STEAM") or os.environ.get("STEAMPLAY_FAKE_RUNNING_PID")):
            subprocess.run(["/usr/bin/osascript", "-e", 'display notification "Steam is running without Protium. '
                            'Open Protium and press Repair." with title "Protium"'],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    else:
        state = {"stops": stops + [time.time()]}
    try:
        os.makedirs(HOME_DIR, exist_ok=True)
        with open(GUARD_STOPS, "w") as f:
            json.dump(state, f)
    except OSError:
        pass
    return not gave_up


def stop_steam():
    """Stops the Steam client: asks first, insists after eight seconds."""
    for sig, wait in ((signal.SIGTERM, 8), (signal.SIGKILL, 4)):
        pids = steam_pids()
        if not pids:
            return True
        for pid in pids:
            try:
                os.kill(pid, sig)
            except OSError:
                pass
        deadline = time.time() + wait
        while time.time() < deadline and steam_pids():
            time.sleep(0.25)
    return not steam_pids()


def cmd_guard():
    fake = os.environ.get("STEAMPLAY_FAKE_STEAM") or os.environ.get("STEAMPLAY_FAKE_RUNNING_PID")
    root, bundle = switch_state()
    if bundle != "linux" or root != "linux":
        write_switch("linux")
        if bundle != "linux":
            guard_log("Steam's platform setting was %s. Set it back to linux." % (bundle or "missing"))
    if not tools_installed():
        if install_tools() is None:
            guard_log("PROBLEM: Protium's tools are missing and %s can't be written to." % TOOLS_DIR)
        else:
            guard_log("Protium's tools were missing. Reinstalled them in %s." % TOOLS_DIR)
    if steam_running():
        session = session_lines()
        state = session_state(session)
        for _ in range(6):      # Steam has only just started: its log says within seconds
            if state != "unknown" or not steam_running():
                break
            time.sleep(2)
            session = session_lines()
            state = session_state(session)
        if state == "ok" and os.path.exists(GUARD_STOPS):
            os.remove(GUARD_STOPS)
        if state in ("ignored", "no-tools") and guard_may_stop(session):
            guard_log("Steam started without Protium's tools (%s). Stopping it before it deletes installed Windows games." % state)
            if not fake:
                subprocess.run(["/usr/bin/osascript", "-e", 'display notification "Steam started without Protium\'s tools. '
                                'Restarting it to protect your installed games." with title "Protium"'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if not stop_steam():
                guard_log("PROBLEM: Steam didn't stop.")
                return 1
            guard_log("Steam stopped. The platform setting and the tools are in place.")
            if tools_installed() and switch_state()[1] == "linux" and not fake:
                subprocess.run([OPEN, "-g", "-a", "Steam"])
                guard_log("Restarted Steam.")
    if not steam_running():
        try:
            wanted, have = wanted_mapping(), current_mapping()
            changes = {a: t for a, (t, _) in wanted.items() if have.get(a) != t}
            if changes:
                cmd_map(changes, quiet=True, silent=True)
                guard_log("Assigned a tool to %d game(s)." % len(changes))
        except (OSError, ValueError, SystemExit) as e:
            guard_log("PROBLEM: couldn't check the games' tool settings: %s" % e)
    return 0


def cmd_guard_watch():
    """The guard as a process that stays: looks every two seconds, which costs a few file checks,
    and runs the guard proper when the switch or a tool is gone, when Steam's compatibility log
    has grown (Steam started, or is busy), when Steam's settings or app cache changed, and every
    five minutes. launchd's own file watching proved too slow and unsure for this: up to a
    minute for a deleted file, where Steam removes installs within half a minute of a bad start."""
    watched = [os.path.join(STEAM_ROOT, "logs", "compat_log.txt"), os.path.join(STEAM_ROOT, "config", "config.vdf"),
               os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf")]

    def stamps():
        out = []
        for path in watched:
            try:
                st = os.stat(path)
                out.append((st.st_mtime, st.st_size))
            except OSError:
                out.append(None)
        return out

    seen, last = None, 0
    while True:
        try:
            now = stamps()
            if switch_state()[1] != "linux" or not tools_installed() or now != seen or time.time() - last > 300:
                cmd_guard()
                seen, last = stamps(), time.time()
        except Exception as e:      # the watch must outlive anything a pass trips over
            guard_log("PROBLEM: %s: %s" % (type(e).__name__, e))
        time.sleep(2)


GUARD_WRAPPER = os.path.join(HOME_DIR, "guard-run.sh")
# What launchd keeps running. While the app is there it is the guard's watch. When Protium.app was
# deleted without "Uninstall", nothing of Protium can run any more, and Steam would stay a Linux
# Steam whose tools start an app that is gone: so this, which needs only /bin/sh, takes Protium
# out of Steam. It waits first (GONE_WAIT seconds; the updater swaps the app, and says so in
# update-pending.json), and it leaves an install from a checkout (APP empty) alone.
GUARD_WRAPPER_TEXT = r"""#!/bin/sh
# Written by "steamplay guard install". See GUARD_WRAPPER_TEXT in steamplay.
PYTHON=%(python)s
SCRIPT=%(script)s
APP=%(app)s
HOME_DIR=%(home)s
STEAM_ROOT=%(steam_root)s
TOOLS_DIR=%(tools_dir)s
PLIST=%(plist)s
LABEL=%(label)s
GONE_WAIT=${STEAMPLAY_GONE_WAIT:-600}
STEP=${STEAMPLAY_GONE_STEP:-30}

watch() { exec "$PYTHON" "$SCRIPT" guard watch; }
there() { [ -z "$APP" ] || { [ -d "$APP" ] && [ -x "$PYTHON" ]; }; }
steam_runs() { [ -z "$STEAMPLAY_FAKE_STEAM" ] && /usr/bin/pgrep -x steam_osx >/dev/null; }

there && watch
waited=0
while [ "$waited" -lt "$GONE_WAIT" ]; do
    /bin/sleep "$STEP"
    waited=$((waited + STEP))
    there && watch
done
# an update in the last day is still putting the app in place, or putting the old one back
if [ -n "$(/usr/bin/find "$HOME_DIR/update-pending.json" -mtime -1 2>/dev/null)" ]; then
    exit 0
fi

for f in "$STEAM_ROOT/steam_dev.cfg" "$STEAM_ROOT/Steam.AppBundle/Steam/Contents/MacOS/steam_dev.cfg"; do
    [ -f "$f" ] || continue
    /usr/bin/grep -v '^@sSteamCmdForcePlatformType ' "$f" > "$f.steamplay-tmp"
    if /usr/bin/grep -q '[^[:space:]]' "$f.steamplay-tmp"; then
        /bin/mv "$f.steamplay-tmp" "$f"
    else
        /bin/rm -f "$f.steamplay-tmp" "$f"
    fi
done
/bin/rm -rf "$TOOLS_DIR/proton-macos" "$TOOLS_DIR/macos-native"
if [ -z "$STEAMPLAY_FAKE_STEAM" ]; then
    /usr/bin/osascript -e 'display notification "Protium was deleted, so it has taken itself out of Steam." with title "Protium"' >/dev/null 2>&1
fi
# Steam's settings (which game starts with which tool) need Python and a Steam that is not
# running. /usr/bin/python3 is only a real one with Apple's developer tools; asking it on a Mac
# without them would put up a window that offers to install them.
if /usr/bin/xcode-select -p >/dev/null 2>&1 && [ -x /usr/bin/python3 ]; then
    waited=0
    while steam_runs && [ "$waited" -lt 86400 ]; do
        /bin/sleep "$STEP"
        waited=$((waited + STEP))
    done
    if ! steam_runs; then
        STEAMPLAY_KEEP_GUARD=1 /usr/bin/python3 -B "$SCRIPT" uninstall >/dev/null 2>&1
    fi
fi
if [ -z "$STEAMPLAY_FAKE_STEAM" ]; then
    /bin/rm -f "$PLIST"
    /bin/launchctl bootout "gui/$(/usr/bin/id -u)/$LABEL"      # ends this script: the last thing it does
fi
exit 0
"""


def write_guard_wrapper(python, script):
    contents = app_contents()
    values = {"python": python, "script": script, "app": os.path.dirname(contents) if contents else "",
              "home": HOME_DIR, "steam_root": STEAM_ROOT, "tools_dir": TOOLS_DIR, "plist": GUARD_PLIST, "label": GUARD_LABEL}
    write_file(GUARD_WRAPPER, GUARD_WRAPPER_TEXT % {k: shlex.quote(v) for k, v in values.items()})
    os.chmod(GUARD_WRAPPER, 0o755)


def guard_job_is_old():
    """Whether launchd's job for the guard is one from before the wrapper: it starts the app's
    Python itself, and so cannot do anything once the app is gone."""
    try:
        with open(GUARD_PLIST, "rb") as f:
            return plistlib.load(f).get("ProgramArguments", [""])[0] != "/bin/sh"
    except (OSError, ValueError):
        return False


def cmd_guard_install():
    if install_tools() is None and not tools_installed():
        stop("%s is missing or can't be written to. Press Set up Steam first." % TOOLS_DIR)
    guard_job_install()


def guard_job_install():
    os.makedirs(HOME_DIR, exist_ok=True)
    here = os.path.dirname(os.path.abspath(__file__))
    script = os.path.join(HOME_DIR, "steamplay")
    if os.path.abspath(__file__) != script:
        shutil.copy2(os.path.abspath(__file__), script)
        dest = os.path.join(HOME_DIR, "steamplay-tools")
        if os.path.isdir(dest):
            shutil.rmtree(dest)
        shutil.copytree(os.path.join(here, "steamplay-tools"), dest)
    # Protium.app runs this with its own Python, which a fresh Mac's /usr/bin/python3 (a stub that
    # asks for the Command Line Tools) cannot stand in for
    if app_contents():
        python = sys.executable
    else:
        python = "/usr/bin/python3" if os.access("/usr/bin/python3", os.X_OK) else sys.executable
    write_guard_wrapper(python, script)
    plist = {
        "Label": GUARD_LABEL,
        "ProgramArguments": ["/bin/sh", GUARD_WRAPPER],
        "EnvironmentVariables": {"STEAMPLAY_HOME": HOME_DIR, "STEAM_ROOT": STEAM_ROOT, "STEAMPLAY_TOOLS_DIR": TOOLS_DIR},
        "RunAtLoad": True,
        "KeepAlive": True,
        "ProcessType": "Background",
        "StandardOutPath": os.path.join(os.path.dirname(GUARD_LOG), "guard.out"),
        "StandardErrorPath": os.path.join(os.path.dirname(GUARD_LOG), "guard.out"),
    }
    os.makedirs(os.path.dirname(GUARD_LOG), exist_ok=True)
    os.makedirs(os.path.dirname(GUARD_PLIST), exist_ok=True)
    with open(GUARD_PLIST, "wb") as f:
        plistlib.dump(plist, f)
    domain = "gui/%d" % os.getuid()
    subprocess.run(["/bin/launchctl", "bootout", "%s/%s" % (domain, GUARD_LABEL)], stderr=subprocess.DEVNULL)
    # launchd is still taking the old job down when bootout returns, and refuses to load the
    # new one until it has (error 5): the guard must not stay unloaded, so try for a while
    for attempt in range(10):
        r = subprocess.run(["/bin/launchctl", "bootstrap", domain, GUARD_PLIST],
                           stderr=subprocess.DEVNULL if attempt < 9 else None)
        if not r.returncode:
            break
        time.sleep(1)
    if r.returncode:
        stop("macOS couldn't start Protium's background helper (%s)." % GUARD_PLIST)
    print("Protium's background helper is running. It keeps Steam set up for Windows games and logs to %s." % GUARD_LOG)


def cmd_guard_remove():
    subprocess.run(["/bin/launchctl", "bootout", "gui/%d/%s" % (os.getuid(), GUARD_LABEL)], stderr=subprocess.DEVNULL)
    for path in (GUARD_PLIST, GUARD_WRAPPER):
        if os.path.exists(path):
            os.remove(path)
    print("Protium's background helper has been removed.")


def cmd_map(choices, dry_run=False, quiet=False, silent=False):
    """choices: {app id: tool name or None}. Writes them into config.vdf's CompatToolMapping."""
    if not dry_run and steam_running():
        die("quit Steam first: it rewrites its settings when it quits")
    path = os.path.join(STEAM_ROOT, "config", "config.vdf")
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        original = f.read()
    tree = vdf_parse(original)
    mapping = vdf_block(tree, ["InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"])
    names = {} if quiet else {appid: name for appid, name, _, _ in windows_games()}
    for appid, tool in sorted(choices.items()):
        old = next((v for k, v in mapping if k == str(appid) and isinstance(v, list)), None)
        oldname = next((v for k, v in old if k == "name"), None) if old else None
        mapping[:] = [kv for kv in mapping if kv[0] != str(appid)]
        if tool:
            mapping.append([str(appid), [["name", tool], ["config", ""], ["priority", "250"]]])
        if not quiet:
            print("%-11s %-9d %s: %s -> %s" % ("would map" if dry_run else "map", appid,
                                               names.get(appid, "default for all games" if appid == 0 else "?"),
                                               oldname or "(none)", tool or "(none)"))
    if dry_run:
        return
    os.makedirs(BACKUPS, exist_ok=True)
    shutil.copy2(path, os.path.join(BACKUPS, "config.vdf.%s" % time.strftime("%Y%m%d-%H%M%S")))
    write_file(path, "\n".join(vdf_dump(tree)) + "\n", encoding="utf-8", errors="surrogateescape")
    if not silent:
        print("Updated the tool settings of %d game(s) in %s." % (len(choices), path))


