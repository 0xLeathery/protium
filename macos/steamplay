HIRES = os.path.join(HOME_DIR, "hires.json")
HIRES_STATES = {"auto": "auto", "on": "1", "off": "0"}


def hires_settings():
    """("auto" | "on" | "off" for every game, {app id: "on" | "off"} for single ones)."""
    data = json_file(HIRES, {})
    data = data if isinstance(data, dict) else {}
    games = data.get("games") if isinstance(data.get("games"), dict) else {}
    return (data.get("all") if data.get("all") in HIRES_STATES else "auto",
            {int(k): v for k, v in games.items() if k.isdigit() and v in ("on", "off")})


def cmd_hires(args):
    """On a HiDPI screen macOS counts in points, two pixels to a point each way, and a game that
    is told the points draws a quarter of the screen's pixels. Wine's Mac driver tells games the
    pixels instead when WINE_MAC_RETINA says so; steamplay-run.sh sets that from here ("hires
    --value <app id>" prints it: auto, 1 or 0)."""
    everything, games = hires_settings()
    if len(args) == 2 and args[0] == "--value":
        print(HIRES_STATES[games.get(int(args[1]), everything)])
        return 0
    appid = int(args[0]) if args and args[0].isdigit() else None
    state = args[-1] if args and args[-1] in HIRES_STATES else None
    if state:
