def steam_pids():
    """Process ids of the running Steam client. For trying things on a copy of a Steam folder:
    STEAMPLAY_FAKE_STEAM=1 says none, STEAMPLAY_FAKE_RUNNING_PID names a stand-in process."""
    fake = os.environ.get("STEAMPLAY_FAKE_RUNNING_PID")
    if fake:
        try:
            os.kill(int(fake), 0)
            return [int(fake)]
        except OSError:
            return []
    if os.environ.get("STEAMPLAY_FAKE_STEAM"):
        return []
    out = subprocess.run(["pgrep", "-x", "steam_osx"], stdout=subprocess.PIPE, universal_newlines=True).stdout
    return [int(x) for x in out.split()]


def steam_running():
    return bool(steam_pids())


def write_file(path, text, **kw):
    """Replaces a file in one step, so that Steam never reads half of it."""
    tmp = path + ".steamplay-tmp"
    with open(tmp, "w", **kw) as f:
        f.write(text)
    os.replace(tmp, path)


def cmd_sync(dry_run, remove=False):
    if not remove and not os.path.isdir(STEAMPLAY_APP):
        die("no %s: make it with macos/make-steamplay-app.sh" % STEAMPLAY_APP)
    if not dry_run and steam_running():
        die("quit Steam first: it rewrites its shortcuts when it quits")
    cfg = steam_user_config()
    path = os.path.join(cfg, "shortcuts.vdf")
    before = list(read_shortcuts(path))
    kept = [s for s in before if TAG not in s.get("tags", {}).values()]
    exe = '"%s"' % OPEN
    made = []
    if remove:
        for s in before:
            if s not in kept:
                print("%s %s" % ("would remove" if dry_run else "remove", s.get("AppName", "?")))
    for appid, name, _, folder in ([] if remove else windows_games()):
        sid = shortcut_id(exe, name)
        art = artwork(appid)
        made.append({
            "appid": struct.unpack("<i", struct.pack("<I", sid))[0],
            "AppName": name,
            "Exe": exe,
            "StartDir": '"%s"' % os.path.dirname(OPEN),
            "icon": art.get("icon", ""),
            "ShortcutPath": "",
            "LaunchOptions": '-a "%s" --args %d' % (STEAMPLAY_APP, appid),
            "IsHidden": 0, "AllowDesktopConfig": 1, "AllowOverlay": 1, "OpenVR": 0,
            "Devkit": 0, "DevkitGameID": "", "DevkitOverrideAppID": 0, "LastPlayTime": 0,
            "FlatpakAppID": "",
            "tags": {"0": TAG},
        })
        print("%s %-9d %s%s" % ("would add" if dry_run else "add", appid, name,
                                ("  (artwork: %s)" % ", ".join(sorted(art))) if art else "  (no artwork cached)"))
        if dry_run:
            continue
        grid = os.path.join(cfg, "grid")
        os.makedirs(grid, exist_ok=True)
        for kind, suffix in (("capsule", "p"), ("header", ""), ("hero", "_hero"), ("logo", "_logo")):
            if kind in art:
                shutil.copyfile(art[kind], os.path.join(grid, "%d%s%s" % (sid, suffix, os.path.splitext(art[kind])[1])))
    if dry_run:
        return
    os.makedirs(BACKUPS, exist_ok=True)
    if os.path.exists(path):
        shutil.copy2(path, os.path.join(BACKUPS, "shortcuts.vdf.%s" % time.strftime("%Y%m%d-%H%M%S")))
    write_shortcuts(path, kept + made)
    print("%d shortcut(s) written to %s, %d other shortcut(s) kept; start Steam to see them" % (len(made), path, len(kept)))


def cmd_hook(appids, remove, dry_run):
    if not remove and not os.access(LAUNCH, os.X_OK):
        die("no launch script " + LAUNCH)
    if not dry_run and steam_running():
        die("quit Steam first: it rewrites its settings when it quits")
    hook = '"%s" %%command%%' % LAUNCH
    names = {appid: name for appid, name, _, _ in windows_games()}
    path = os.path.join(steam_user_config(), "localconfig.vdf")
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        text = original = f.read()

    def change(old):
        ours = old is not None and "steamplay-launch" in old and "%command%" in old
        rest = old.split("%command%", 1)[1].strip() if ours else (old or "")
        if remove:
            return (rest or None) if ours else old
        if old and not ours and "%command%" in old:
            return old                      # someone else's wrapper: leave it
        return hook + (" " + rest if rest else "")

    for appid in appids or sorted(names):
        text, old, new = app_setting(text, appid, "LaunchOptions", change)
        what = "unchanged" if old == new else ("would set" if dry_run else "set") if new is not None else \
               ("would clear" if dry_run else "cleared")
        print("%-11s %-9d %s: %s" % (what, appid, names.get(appid, "?"), new if new is not None else "(no launch option)"))
    if dry_run or text == original:
        return
    os.makedirs(BACKUPS, exist_ok=True)
    shutil.copy2(path, os.path.join(BACKUPS, "localconfig.vdf.%s" % time.strftime("%Y%m%d-%H%M%S")))
    write_file(path, text, encoding="utf-8", errors="surrogateescape")
    print("written to %s; start Steam" % path)


