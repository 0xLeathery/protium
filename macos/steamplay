def curl(url, output=None):
    """GET url with macOS's own curl (the system's certificates, whatever Python runs this), to the
    file output, or as bytes."""
    cmd = ["/usr/bin/curl", "-fsSL", "--retry", "3", "--max-time", "600", url]
    if output:
        cmd[1:1] = ["-o", output]
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r.returncode != 0:
        die("could not download %s: %s" % (url, r.stderr.decode(errors="replace").strip() or "curl %d" % r.returncode))
    return r.stdout


# ---- this version, and whether there is a newer one
#
# The version is in the file VERSION next to this script (the app) or in app/VERSION (a
# checkout). "version --check" asks GitHub for the newest release of Protium. That is one request
# to a public address, which says nothing about this Mac or its games.

RELEASES_API = os.environ.get("PROTIUM_RELEASES_API", "https://api.github.com/repos/0xLeathery/protium/releases?per_page=10")
RELEASES_PAGE = "https://github.com/0xLeathery/protium/releases"
RELEASES_DOWNLOAD = "https://github.com/0xLeathery/protium/releases/download/"
SETTINGS = os.path.join(HOME_DIR, "settings.json")
