LAUNCH = os.environ.get("STEAMPLAY_LAUNCH", os.path.join(os.path.dirname(os.path.abspath(__file__)), "steamplay-launch"))
TAG = "Steam Play"          # marks the shortcuts that sync owns
OPEN = "/usr/bin/open"


def die(msg):
    sys.exit("steamplay: error: " + msg)


def stop(msg):
    """Ends with a sentence for the player, as Protium's window shows it."""
    sys.exit(msg)


# ---------------------------------------------------------------- text VDF (manifests, libraries)

def text_vdf_values(path, key):
    """Every value of a "key" "value" line in a text VDF file."""
    with open(path, encoding="utf-8", errors="replace") as f:
        return re.findall(r'^\s*"' + re.escape(key) + r'"\s*"(.*)"\s*$', f.read(), re.M)


def libraries():
    paths = text_vdf_values(os.path.join(STEAM_ROOT, "steamapps", "libraryfolders.vdf"), "path")
    return [p for p in paths if os.path.isdir(os.path.join(p, "steamapps"))]


def windows_games():
    """(app id, name, library, install folder) of every installed app whose folder holds a
    Windows program and no Mac app."""
    games = []
    for lib in libraries():
        apps = os.path.join(lib, "steamapps")
        for entry in sorted(os.listdir(apps)):
            m = re.fullmatch(r"appmanifest_(\d+)\.acf", entry)
            if not m:
                continue
            manifest = os.path.join(apps, entry)
            name = (text_vdf_values(manifest, "name") or [m.group(1)])[0]
            installdir = (text_vdf_values(manifest, "installdir") or [""])[0]
            folder = os.path.join(apps, "common", installdir)
            if not installdir or not os.path.isdir(folder):
                continue
            files = os.listdir(folder)
            if any(f.lower().endswith(".exe") for f in files) and not any(f.endswith(".app") for f in files):
                games.append((int(m.group(1)), name, lib, folder))
    return games


def vdf_quote(value):
    return value.replace("\\", "\\\\").replace('"', '\\"')


def vdf_unquote(value):
    return re.sub(r"\\(.)", r"\1", value)


def app_setting(text, appid, key, change):
    """A user's localconfig.vdf with one setting of one app changed: `change` gets the setting's
    value (None when it is not there) and returns the new one (None to remove it). Returns the new
    text and the old and new values. The file is as Steam writes it: a key or a brace a line."""
    want = ["userlocalconfigstore", "software", "valve", "steam", "apps", str(appid)]
    lines = text.split("\n")
    path, out, old, new, done, pending = [], [], None, None, False, None
    setting = re.compile(r'^(\s*)"' + re.escape(key) + r'"\s+"(.*)"\s*$', re.I)
    for line in lines:
        stripped = line.strip()
        here = [p.lower() for p in path]
        if stripped == "{":
            path.append(pending or "")
            pending = None
        elif stripped == "}":
            indent = line[:len(line) - len(line.lstrip())]
            if here == want and not done:           # the app's block ends without the setting
                new = change(None)
                if new is not None:
                    out.append('%s\t"%s"\t\t"%s"' % (indent, key, vdf_quote(new)))
                done = True
            elif here == want[:-1] and not done:    # the apps block ends without the app
                new = change(None)
                if new is not None:
                    out += ['%s\t"%d"' % (indent, appid), indent + "\t{",
                            '%s\t\t"%s"\t\t"%s"' % (indent, key, vdf_quote(new)), indent + "\t}"]
                done = True
            path.pop()
        elif here == want and setting.match(line) and not done:
            m = setting.match(line)
            old = vdf_unquote(m.group(2))
            new = change(old)
            done = True
            if new is None:
                continue
            line = '%s"%s"\t\t"%s"' % (m.group(1), key, vdf_quote(new))
        else:
            m = re.fullmatch(r'"((?:[^"\\]|\\.)*)"', stripped)
            pending = m.group(1) if m else None
        out.append(line)
    if not done:
        die("no Software/Valve/Steam/apps section in localconfig.vdf")
    return "\n".join(out), old, new


def vdf_parse(text):
    """A text VDF file as nested lists of [key, value] pairs (value: str or list), in order."""
    stack = [[]]
    key = None
    for m in re.finditer(r'"((?:[^"\\]|\\.)*)"|\{|\}|//[^\n]*', text):
        token = m.group(0)
        if token == "{":
            block = []
            stack[-1].append([key, block])
            stack.append(block)
            key = None
        elif token == "}":
            stack.pop()
        elif token.startswith('"'):
            if key is None:
                key = vdf_unquote(m.group(1))
            else:
                stack[-1].append([key, vdf_unquote(m.group(1))])
                key = None
    return stack[0]


def vdf_dump(pairs, depth=0):
    out = []
    for key, value in pairs:
        if isinstance(value, list):
            out += ["\t" * depth + '"%s"' % vdf_quote(key), "\t" * depth + "{"]
            out += vdf_dump(value, depth + 1)
            out.append("\t" * depth + "}")
        else:
            out.append("\t" * depth + '"%s"\t\t"%s"' % (vdf_quote(key), vdf_quote(value)))
    return out


def vdf_block(pairs, path):
    """The block at a path of keys (compared without case), made if missing."""
    for name in path:
        for key, value in pairs:
            if isinstance(value, list) and key.lower() == name.lower():
                pairs = value
                break
        else:
            block = []
            pairs.append([name, block])
            pairs = block
    return pairs


# ---------------------------------------------------------------- binary VDF (shortcuts.vdf)

def bvdf_read(data, pos=0):
    """Read a map's entries from pos up to its end byte; return (dict, position after it)."""
    out = {}
    while True:
        kind = data[pos]
        pos += 1
        if kind == 0x08:
            return out, pos
        end = data.index(b"\0", pos)
        key = data[pos:end].decode("utf-8", "replace")
        pos = end + 1
        if kind == 0x00:
            out[key], pos = bvdf_read(data, pos)
        elif kind == 0x01:
            end = data.index(b"\0", pos)
            out[key] = data[pos:end].decode("utf-8", "replace")
            pos = end + 1
        elif kind == 0x02:
            out[key] = struct.unpack_from("<i", data, pos)[0]
            pos += 4
        else:
            raise ValueError("unknown binary VDF type %#x at %d" % (kind, pos - 1))


def bvdf_write(obj):
    out = bytearray()
    for key, value in obj.items():
        k = key.encode("utf-8") + b"\0"
        if isinstance(value, dict):
            out += b"\x00" + k + bvdf_write(value)
        elif isinstance(value, int):
            out += b"\x02" + k + struct.pack("<i", value)
        else:
            out += b"\x01" + k + str(value).encode("utf-8") + b"\0"
    return bytes(out) + b"\x08"


def read_shortcuts(path):
    if not os.path.exists(path):
        return []
    with open(path, "rb") as f:
        data = f.read()
    if not data:
        return []
    root, _ = bvdf_read(data, 0)
    return [root["shortcuts"][k] for k in sorted(root.get("shortcuts", {}), key=int)]


def write_shortcuts(path, shortcuts):
    root = {"shortcuts": {str(i): s for i, s in enumerate(shortcuts)}}
    with open(path + ".new", "wb") as f:
        f.write(bvdf_write(root))    # which ends the root map as well: nothing follows it
    os.replace(path + ".new", path)


def shortcut_id(exe, name):
    """The id Steam gives a non-Steam shortcut: its artwork files are named after it."""
    return zlib.crc32((exe + name).encode("utf-8")) | 0x80000000


# ---------------------------------------------------------------- user and artwork

def signed_in_user_config():
    """The config folder of the user who signed in last (the one whose localconfig.vdf is newest),
    or None when nobody has signed in to this Steam yet."""
    base = os.path.join(STEAM_ROOT, "userdata")
    best = None
    try:
        uids = os.listdir(base)
    except OSError:
        return None
    for uid in uids:
        cfg = os.path.join(base, uid, "config")
        lc = os.path.join(cfg, "localconfig.vdf")
        if uid.isdigit() and uid != "0" and os.path.exists(lc):
            if not best or os.path.getmtime(lc) > os.path.getmtime(os.path.join(best, "localconfig.vdf")):
                best = cfg
    return best


def steam_user_config():
    best = signed_in_user_config()
    if not best:
        die("no signed-in Steam user under " + os.path.join(STEAM_ROOT, "userdata"))
    return best


def steam_ready():
    """None when this Steam has what setup reads, else a sentence for the player that says what to
    do. Steam writes its app cache, its settings and its library list on its first start, and a
    user's folder when somebody signs in; a Steam that was installed and never opened has none."""
    if not os.path.isdir(STEAM_ROOT):
        return ("Steam isn't installed, or hasn't been opened yet. Install Steam, open it and sign in, "
                "then press Set up Steam again.")
    needed = [os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf"), os.path.join(STEAM_ROOT, "config", "config.vdf"),
              os.path.join(STEAM_ROOT, "steamapps", "libraryfolders.vdf")]
    if not all(os.path.isfile(f) for f in needed) or not signed_in_user_config():
        return ("Steam hasn't finished its first start. Open Steam, sign in, wait for your library to appear, "
                "quit Steam, then press Set up Steam again.")
    return None


def artwork(appid):
    """Steam's cached artwork of an app: {kind: path} for capsule, header, hero, logo, icon."""
    cache = os.path.join(STEAM_ROOT, "appcache", "librarycache", str(appid))
    found = {}
    if not os.path.isdir(cache):
        return found
    for dirpath, _, files in os.walk(cache):
        for f in files:
            kind = {"library_capsule": "capsule", "library_600x900": "capsule", "library_header": "header",
                    "header": "header", "library_hero": "hero", "logo": "logo"}.get(os.path.splitext(f)[0])
            if kind and (kind not in found or "600x900" in f):
                found[kind] = os.path.join(dirpath, f)
            elif dirpath == cache and f.endswith(".jpg") and "icon" not in found:
                found["icon"] = os.path.join(dirpath, f)
    return found


# ---------------------------------------------------------------- commands

def cmd_list():
    for appid, name, lib, folder in windows_games():
        print("%-9d %s  (%s)" % (appid, name, folder))


def steam_pids():
    """Process ids of the running Steam client. For trying things on a copy of a Steam folder:
    STEAMPLAY_FAKE_STEAM=1 says none, STEAMPLAY_FAKE_RUNNING_PID names a stand-in process."""
    fake = os.environ.get("STEAMPLAY_FAKE_RUNNING_PID")
    if fake:
        try:
            os.kill(int(fake), 0)
            return [int(fake)]
        except OSError:
            return []
    if os.environ.get("STEAMPLAY_FAKE_STEAM"):
        return []
    out = subprocess.run(["pgrep", "-x", "steam_osx"], stdout=subprocess.PIPE, universal_newlines=True).stdout
    return [int(x) for x in out.split()]


def steam_running():
    return bool(steam_pids())


def write_file(path, text, **kw):
    """Replaces a file in one step, so that Steam never reads half of it."""
    tmp = path + ".steamplay-tmp"
    with open(tmp, "w", **kw) as f:
        f.write(text)
    os.replace(tmp, path)


def cmd_sync(dry_run, remove=False):
    if not remove and not os.path.isdir(STEAMPLAY_APP):
        die("no %s: make it with macos/make-steamplay-app.sh" % STEAMPLAY_APP)
    if not dry_run and steam_running():
        die("quit Steam first: it rewrites its shortcuts when it quits")
    cfg = steam_user_config()
    path = os.path.join(cfg, "shortcuts.vdf")
    before = list(read_shortcuts(path))
    kept = [s for s in before if TAG not in s.get("tags", {}).values()]
    exe = '"%s"' % OPEN
    made = []
    if remove:
        for s in before:
            if s not in kept:
                print("%s %s" % ("would remove" if dry_run else "remove", s.get("AppName", "?")))
    for appid, name, _, folder in ([] if remove else windows_games()):
        sid = shortcut_id(exe, name)
        art = artwork(appid)
        made.append({
            "appid": struct.unpack("<i", struct.pack("<I", sid))[0],
            "AppName": name,
            "Exe": exe,
            "StartDir": '"%s"' % os.path.dirname(OPEN),
            "icon": art.get("icon", ""),
            "ShortcutPath": "",
            "LaunchOptions": '-a "%s" --args %d' % (STEAMPLAY_APP, appid),
            "IsHidden": 0, "AllowDesktopConfig": 1, "AllowOverlay": 1, "OpenVR": 0,
            "Devkit": 0, "DevkitGameID": "", "DevkitOverrideAppID": 0, "LastPlayTime": 0,
            "FlatpakAppID": "",
            "tags": {"0": TAG},
        })
        print("%s %-9d %s%s" % ("would add" if dry_run else "add", appid, name,
                                ("  (artwork: %s)" % ", ".join(sorted(art))) if art else "  (no artwork cached)"))
        if dry_run:
            continue
        grid = os.path.join(cfg, "grid")
        os.makedirs(grid, exist_ok=True)
        for kind, suffix in (("capsule", "p"), ("header", ""), ("hero", "_hero"), ("logo", "_logo")):
            if kind in art:
                shutil.copyfile(art[kind], os.path.join(grid, "%d%s%s" % (sid, suffix, os.path.splitext(art[kind])[1])))
    if dry_run:
        return
    os.makedirs(BACKUPS, exist_ok=True)
    if os.path.exists(path):
        shutil.copy2(path, os.path.join(BACKUPS, "shortcuts.vdf.%s" % time.strftime("%Y%m%d-%H%M%S")))
    write_shortcuts(path, kept + made)
    print("%d shortcut(s) written to %s, %d other shortcut(s) kept; start Steam to see them" % (len(made), path, len(kept)))


def cmd_hook(appids, remove, dry_run):
    if not remove and not os.access(LAUNCH, os.X_OK):
        die("no launch script " + LAUNCH)
    if not dry_run and steam_running():
        die("quit Steam first: it rewrites its settings when it quits")
    hook = '"%s" %%command%%' % LAUNCH
    names = {appid: name for appid, name, _, _ in windows_games()}
    path = os.path.join(steam_user_config(), "localconfig.vdf")
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        text = original = f.read()

    def change(old):
        ours = old is not None and "steamplay-launch" in old and "%command%" in old
        rest = old.split("%command%", 1)[1].strip() if ours else (old or "")
        if remove:
            return (rest or None) if ours else old
        if old and not ours and "%command%" in old:
            return old                      # someone else's wrapper: leave it
        return hook + (" " + rest if rest else "")

    for appid in appids or sorted(names):
        text, old, new = app_setting(text, appid, "LaunchOptions", change)
        what = "unchanged" if old == new else ("would set" if dry_run else "set") if new is not None else \
               ("would clear" if dry_run else "cleared")
        print("%-11s %-9d %s: %s" % (what, appid, names.get(appid, "?"), new if new is not None else "(no launch option)"))
    if dry_run or text == original:
        return
    os.makedirs(BACKUPS, exist_ok=True)
    shutil.copy2(path, os.path.join(BACKUPS, "localconfig.vdf.%s" % time.strftime("%Y%m%d-%H%M%S")))
    write_file(path, text, encoding="utf-8", errors="surrogateescape")
    print("written to %s; start Steam" % path)


TOOLS_SRC = os.path.join(os.path.dirname(os.path.abspath(__file__)), "steamplay-tools")
# a tool is a folder: Finder's .DS_Store, for one, is not
TOOLS = sorted(t for t in os.listdir(TOOLS_SRC)
               if not t.startswith(".") and os.path.isdir(os.path.join(TOOLS_SRC, t))) if os.path.isdir(TOOLS_SRC) else []
# Mac Steam looks for tools only in /usr/share/steam, /usr/local/share/steam (each with a
# compatibilitytools.d), $STEAM_EXTRA_COMPAT_TOOLS_PATHS and the folder of its own client library
# inside its app bundle (steamclient.dylib's CLoadLocalToolListJob). /usr/local is the one outside
# everything Steam manages, so client updates do not touch it.
