def app_cache():
    """Steam's cache of app metadata, appcache/appinfo.vdf: {app id: {name, type, oslist, osextended}}."""
    path = os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf")
    with open(path, "rb") as f:
        d = f.read()
    magic, = struct.unpack_from("<I", d, 0)
    if magic != 0x07564429:
        die("%s has format %#x, not the one this reads (0x7564429)" % (path, magic))
    table, = struct.unpack_from("<q", d, 8)
    count, = struct.unpack_from("<I", d, table)
    strings, pos = [], table + 4
    for _ in range(count):
        end = d.index(b"\0", pos)
        strings.append(d[pos:end].decode("utf-8", "replace"))
        pos = end + 1

    def block(pos):
        out = {}
        while True:
            kind = d[pos]
            pos += 1
            if kind == 8:
                return out, pos
            key = strings[struct.unpack_from("<I", d, pos)[0]]
            pos += 4
            if kind == 0:
                value, pos = block(pos)
            elif kind == 1:
                end = d.index(b"\0", pos)
                value, pos = d[pos:end].decode("utf-8", "replace"), end + 1
            elif kind == 2:
                value, pos = struct.unpack_from("<i", d, pos)[0], pos + 4
            elif kind == 7:
                value, pos = struct.unpack_from("<Q", d, pos)[0], pos + 8
            else:
                raise ValueError("value type %d" % kind)
            out[key] = value

    apps, pos = {}, 16
    while pos < table:
        appid, size = struct.unpack_from("<II", d, pos)
        if not appid:
            break
        try:    # after id and size: state, time, token, a hash, change number, a hash
            root = block(pos + 8 + 60)[0]
            common = root.get("appinfo", root).get("common", {})
            apps[appid] = {"name": str(common.get("name", "?")), "type": str(common.get("type", "")).lower(),
                           "oslist": [x for x in str(common.get("oslist", "")).split(",") if x],
                           "osextended": [x for x in str(common.get("osextended", "")).split(",") if x]}
        except (ValueError, IndexError, struct.error):
            pass
        pos += 8 + size
    return apps


def rule(app):
    """The tool for a game by the rule, and why."""
    if "macos" in app["oslist"]:
        if "macosapplesilicon" in app["osextended"]:
            return NATIVE, "has a Mac build for Apple Silicon"
        if "macos64" in app["osextended"]:
            return NATIVE, "has a 64-bit Mac build (runs under Rosetta)"
        return PROTON, "its Mac build is 32-bit, which this macOS cannot run"
    if "linux" in app["oslist"]:
        return PROTON, "no Mac build (and its Linux build must not be chosen)"
    return PROTON, "Windows only"


def read_choices():
    try:
        with open(CHOICES) as f:
            return {int(k): v for k, v in json.load(f).items() if v in ("native", "proton")}
    except (OSError, ValueError):
        return {}


def switch_state():
    """The platform each steam_dev.cfg sets, or None."""
    out = []
    for path in SWITCH_FILES:
        try:
            with open(path) as f:
                found = [l.split()[1] for l in f.read().splitlines() if l.startswith(SWITCH + " ") and len(l.split()) > 1]
        except OSError:
            found = []
        out.append(found[-1] if found else None)
    return out


def write_switch(platform):
    for path in SWITCH_FILES:
        if not os.path.isdir(os.path.dirname(path)):
            continue
        try:
            with open(path) as f:
                lines = [l for l in f.read().splitlines() if not l.startswith(SWITCH + " ")]
        except OSError:
            lines = []
        write_file(path, "\n".join(lines + ["%s %s" % (SWITCH, platform)]) + "\n")


def tools_installed():
    return all(os.access(os.path.join(TOOLS_DIR, t, "run"), os.X_OK) for t in TOOLS)


def current_mapping():
    path = os.path.join(STEAM_ROOT, "config", "config.vdf")
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        tree = vdf_parse(f.read())
    mapping = vdf_block(tree, ["InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"])
    return {int(k): next((x for n, x in v if n == "name"), None) for k, v in mapping if isinstance(v, list) and k.isdigit()}


def wanted_mapping():
    """{app id: (tool, why)} for the default and every cached game that needs its own entry."""
    choices = read_choices()
    out = {0: (PROTON, "the default, for games Steam's cache does not have yet")}
    for appid, app in app_cache().items():
        if app["type"] not in ("game", "demo", "application", "beta") or not app["oslist"]:
            continue
        tool, why = rule(app)
        if appid in choices:
            tool, why = (NATIVE if choices[appid] == "native" else PROTON), "your choice"
        if tool == NATIVE or app["oslist"] != ["windows"] or appid in choices:
            out[appid] = (tool, why)
    return out


def cmd_setup(dry_run):
    if not dry_run and steam_running():
        die("quit Steam first: it reads its tools and settings when it starts")
    wanted = wanted_mapping()
    have = current_mapping()
    changes = {a: t for a, (t, _) in wanted.items() if have.get(a) != t}
    native = sum(1 for t, _ in wanted.values() if t == NATIVE)
    print("%d games get their Mac build, %d with a Mac or Linux build get Proton, every other game Proton by default"
          % (native, len(wanted) - native - 1))
    cache = app_cache()
    names = {a: cache[a]["name"] for a in cache}
    for appid, _, lib, _ in installed_apps():
        if appid in cache and cache[appid]["type"] in ("game", "demo", "application", "beta"):
            tool, why = wanted.get(appid, (PROTON, "Windows only"))
            print("  installed  %-9d %-45s %s: %s" % (appid, names.get(appid, "?")[:45], tool, why))
    if dry_run:
        print("would write %d mapping(s), the switch to linux, and the tools into %s" % (len(changes), TOOLS_DIR))
        return
    cmd_tools()
    write_switch("linux")
    print("switch: %s linux" % SWITCH)
    if changes:
        cmd_map(changes, quiet=True)
    else:
        print("mappings already as wanted")
    hooked = hooked_apps()
    if hooked:
        cmd_hook(hooked, True, False)
    print("done; start Steam")


def cmd_prefer(appid, choice):
    if steam_running():
        die("quit Steam first: it rewrites its settings when it quits")
    cache = app_cache()
    if appid not in cache:
        die("Steam's cache has no app %d" % appid)
    choices = read_choices()
    choices.pop(appid, None)
    if choice != "auto":
        if choice == "native" and "macos" not in cache[appid]["oslist"]:
            die("%s has no Mac build" % cache[appid]["name"])
        choices[appid] = choice
    os.makedirs(os.path.dirname(CHOICES), exist_ok=True)
    with open(CHOICES, "w") as f:
        json.dump({str(k): v for k, v in sorted(choices.items())}, f, indent=1)
    tool, why = wanted_mapping().get(appid, (None, "Windows only: Proton by default"))
    print("%d %s: %s (%s)" % (appid, cache[appid]["name"], tool or PROTON, why))
    cmd_map({appid: tool}, quiet=True)


def installed_apps():
    """(app id, name, library, installed depot ids) of every app with a manifest."""
    out = []
    for lib in libraries():
        apps = os.path.join(lib, "steamapps")
        for entry in sorted(os.listdir(apps)):
            m = re.fullmatch(r"appmanifest_(\d+)\.acf", entry)
            if not m:
                continue
            with open(os.path.join(apps, entry), encoding="utf-8", errors="replace") as f:
                tree = vdf_parse(f.read())
            state = vdf_block(tree, ["AppState"])
            name = next((v for k, v in state if k == "name" and isinstance(v, str)), m.group(1))
            depots = [k for k, v in vdf_block(state, ["InstalledDepots"]) if isinstance(v, list)]
            out.append((int(m.group(1)), name, lib, depots))
    return out


def hooked_apps():
    """App ids whose launch option is hook's."""
    path = os.path.join(steam_user_config(), "localconfig.vdf")
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        tree = vdf_parse(f.read())
    apps = vdf_block(tree, ["UserLocalConfigStore", "Software", "Valve", "Steam", "apps"])
    return [int(k) for k, v in apps if isinstance(v, list) and k.isdigit()
            and any(n == "LaunchOptions" and "steamplay-launch" in x for n, x in v if isinstance(x, str))]


def cmd_status():
    problems = []
    root, bundle = switch_state()
    print("Steam is %s" % ("running" if steam_running() else "not running"))
    print("switch: %s (the copy Steam reads, next to its executables); %s (Steam root)" % (bundle or "none", root or "none"))
    if bundle != "linux":
        problems.append("the switch is not on linux: Steam Play is off, and Steam will take Windows installs for "
                        "wrong at its next start")
    present = [t for t in TOOLS if os.access(os.path.join(TOOLS_DIR, t, "run"), os.X_OK)]
    print("tools in %s: %s" % (TOOLS_DIR, ", ".join(present) or "none"))
    if len(present) != len(TOOLS):
        problems.append("tools are missing: Steam will take the games mapped to them for Linux games")
    have, wanted, cache = current_mapping(), wanted_mapping(), app_cache()
    print("default for games not listed: %s" % (have.get(0) or "none"))
    if have.get(0) != PROTON:
        problems.append("no default mapping to %s" % PROTON)
    stale = sum(1 for a, (t, _) in wanted.items() if have.get(a) != t)
    print("mappings: %d of ours in Steam's settings, %d to write" % (sum(1 for t in have.values() if t in TOOLS), stale))
    if stale:
        problems.append("%d game(s) are not mapped by the rule yet (new games?)" % stale)
    for appid, name, lib, depots in installed_apps():
        if appid not in cache or cache[appid]["type"] not in ("game", "demo", "application", "beta"):
            continue
        tool, why = wanted.get(appid, (PROTON, "Windows only"))
        mapped = have.get(appid) or ("%s (default)" % have.get(0) if have.get(0) else "none")
        print("  %-9d %-42s %-13s %s; mapped: %s; depots: %s" % (appid, name[:42], tool, why, mapped, " ".join(depots) or "none"))
    loaded = subprocess.run(["/bin/launchctl", "print", "gui/%d/%s" % (os.getuid(), GUARD_LABEL)],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    print("guard: %s" % ("installed" if loaded else "not installed (nothing repairs a lost switch or tool by itself)"))
    if steam_running():
        print("Steam's own log says of this start: %s" % session_state())
    for p in problems:
        print("PROBLEM: " + p)
    if problems:
        print("Quit Steam and run: %s setup" % os.path.abspath(__file__))
    return 1 if problems else 0


def install_tools():
    """Copies the tools into the folder Steam scans. Returns what it installed, or None when the
    folder is missing or not writable."""
    if not os.path.isdir(TOOLS_DIR) or not os.access(TOOLS_DIR, os.W_OK):
        return None
    for tool in TOOLS:
        target = os.path.join(TOOLS_DIR, tool)
        if os.path.isdir(target):
            shutil.rmtree(target)
        shutil.copytree(os.path.join(TOOLS_SRC, tool), target)
    return TOOLS


def cmd_tools():
    if steam_running():
        die("quit Steam first: it reads its tools when it starts")
    if install_tools() is None:
        die("%s is missing or not writable. Make it once, as an administrator:\n"
            "    sudo mkdir -p %s && sudo chown \"$USER\" %s" % (TOOLS_DIR, TOOLS_DIR, TOOLS_DIR))
    for tool in TOOLS:
        print("installed %s in %s" % (tool, os.path.join(TOOLS_DIR, tool)))


# ---------------------------------------------------------------- symbolic links of Mac builds

def depot_links(path):
    """(file name, link target) of every symbolic link in a depot manifest of Steam's depotcache:
    sections of magic, length and a protobuf message; in the payload section each file is
    field 1, with its name in field 1 and, for a link, the target in field 7."""
    def varint(data, pos):
        value = shift = 0
        while True:
            byte = data[pos]
            pos += 1
            value |= (byte & 0x7f) << shift
            shift += 7
            if byte < 0x80:
                return value, pos

    def fields(data):
        pos = 0
        while pos < len(data):
            key, pos = varint(data, pos)
            kind = key & 7
            if kind == 0:
                value, pos = varint(data, pos)
            elif kind == 2:
                size, pos = varint(data, pos)
                value = data[pos:pos + size]
                pos += size
            elif kind in (1, 5):
                size = 8 if kind == 1 else 4
                value = data[pos:pos + size]
                pos += size
            else:
                raise ValueError("unknown protobuf wire type %d" % kind)
            yield key >> 3, value

    with open(path, "rb") as f:
        data = f.read()
    links, pos = [], 0
    while pos + 8 <= len(data):
        magic, size = struct.unpack_from("<II", data, pos)
        pos += 8
        if magic == 0x71F617D0:
            for field, entry in fields(data[pos:pos + size]):
                if field != 1:
                    continue
                parts = dict((n, v) for n, v in fields(entry) if n in (1, 7) and isinstance(v, bytes))
                if parts.get(7):
                    links.append((parts.get(1, b"").decode("utf-8"), parts[7].decode("utf-8")))
        pos += size
    return links


def restore_links(appid):
    """Makes the symbolic links of an installed game's depots that are missing in its folder.
    Returns (made, problems)."""
    made, problems = [], []
    for lib in libraries():
        manifest = os.path.join(lib, "steamapps", "appmanifest_%d.acf" % appid)
        if not os.path.isfile(manifest):
            continue
        with open(manifest, encoding="utf-8", errors="replace") as f:
            state = vdf_block(vdf_parse(f.read()), ["AppState"])
        installdir = next((v for k, v in state if k == "installdir" and isinstance(v, str)), None)
        if not installdir:
            continue
        root = os.path.realpath(os.path.join(lib, "steamapps", "common", installdir))
        for depot, info in vdf_block(state, ["InstalledDepots"]):
            gid = next((v for k, v in info if k == "manifest" and isinstance(v, str)), None) if isinstance(info, list) else None
            path = os.path.join(STEAM_ROOT, "depotcache", "%s_%s.manifest" % (depot, gid))
            if not gid or not os.path.isfile(path):
                continue
            try:
                links = depot_links(path)
            except (OSError, ValueError, IndexError, struct.error) as e:
                problems.append("depot %s: %s" % (depot, e))
                continue
            for name, target in links:
                link = os.path.normpath(os.path.join(root, name.replace("\\", "/")))
                parent = os.path.realpath(os.path.dirname(link))
                # a link goes inside the game's folder and nowhere else, whatever a manifest says
                if not (parent + os.sep).startswith(root + os.sep) and parent != root:
                    problems.append("%s is outside %s" % (name, root))
                elif not os.path.lexists(link) and os.path.isdir(parent):
                    try:
                        os.symlink(target, link)
                        made.append(link)
                    except OSError as e:
                        problems.append("%s: %s" % (link, e))
    return made, problems


def cmd_links(appids):
    if not appids:
        mapped = current_mapping()
        appids = [a for a, _, _, _ in installed_apps() if mapped.get(a) == NATIVE]
    status = 0
    for appid in appids:
        made, problems = restore_links(appid)
        for p in problems:
            print("PROBLEM: %d: %s" % (appid, p))
        print("%d: %d link(s) made%s" % (appid, len(made), "".join("\n    " + m for m in made)))
        status = status or (1 if problems else 0)
    return status


# ---------------------------------------------------------------- the guard

def session_state():
    """What Steam's compatibility log says of the client's latest start: "ok" (our tools are
    registered), "ignored" (they were turned down: Steam's platform is not linux), "no-tools"
    (they were not there when it started), or "unknown" (too early to say, or no log)."""
    path = os.path.join(STEAM_ROOT, "logs", "compat_log.txt")
    marker = b"] Client version:"
    try:    # the log runs to megabytes a start: find the last start from the end, then read its head
        with open(path, "rb") as f:
            f.seek(0, os.SEEK_END)
            end = pos = f.tell()
            at = -1
            while pos > 0 and at < 0 and end - pos < (256 << 20):
                step = min(pos, 1 << 20)
                pos -= step
                f.seek(pos)
                chunk = f.read(step + len(marker))
                at = chunk.rfind(marker)
            if at < 0:
                return "unknown"
            f.seek(max(0, pos + at - 22))
            head = f.read(65536).decode("utf-8", "replace")
    except OSError:
        return "unknown"
    session = head[head.index("["):].splitlines() if "[" in head else []
    if not session:
        return "unknown"
    if any("Ignoring tool %s " % t in l for l in session for t in TOOLS):
        return "ignored"
    if all(any("Registering tool %s," % t in l for l in session) for t in TOOLS):
        return "ok"
    try:    # the tools are read in the first second: give a start five before judging
        began = time.mktime(time.strptime(session[0][1:20], "%Y-%m-%d %H:%M:%S"))
    except ValueError:
        return "unknown"
    return "no-tools" if time.time() - began > 5 else "unknown"


def guard_log(message):
    line = "%s %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), message)
    try:
        os.makedirs(os.path.dirname(GUARD_LOG), exist_ok=True)
        with open(GUARD_LOG, "a") as f:
            f.write(line + "\n")
    except OSError:
        pass
    print(line)


def stop_steam():
    """Stops the Steam client: asks first, insists after eight seconds."""
    for sig, wait in ((signal.SIGTERM, 8), (signal.SIGKILL, 4)):
        pids = steam_pids()
        if not pids:
            return True
        for pid in pids:
            try:
                os.kill(pid, sig)
            except OSError:
                pass
        deadline = time.time() + wait
        while time.time() < deadline and steam_pids():
            time.sleep(0.25)
    return not steam_pids()


def cmd_guard():
    fake = os.environ.get("STEAMPLAY_FAKE_STEAM") or os.environ.get("STEAMPLAY_FAKE_RUNNING_PID")
    root, bundle = switch_state()
    if bundle != "linux" or root != "linux":
        write_switch("linux")
        if bundle != "linux":
            guard_log("the switch was %s: set to linux again" % (bundle or "gone"))
    if not tools_installed():
        if install_tools() is None:
            guard_log("PROBLEM: the tools are missing and %s is missing or not writable" % TOOLS_DIR)
        else:
            guard_log("the tools were missing: installed again in %s" % TOOLS_DIR)
    if steam_running():
        state = session_state()
        for _ in range(6):      # Steam has only just started: its log says within seconds
            if state != "unknown" or not steam_running():
                break
            time.sleep(2)
            state = session_state()
        if state in ("ignored", "no-tools"):
            guard_log("Steam is running without Steam Play (%s): stopping it before it removes installs" % state)
            if not fake:
                subprocess.run(["/usr/bin/osascript", "-e", 'display notification "Steam started without Steam Play. '
                                'Restarting it to protect your installed games." with title "Steam Play"'],
                               stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if not stop_steam():
                guard_log("PROBLEM: Steam did not stop")
                return 1
            guard_log("Steam stopped; the switch and the tools are in place")
            if tools_installed() and switch_state()[1] == "linux" and not fake:
                subprocess.run([OPEN, "-g", "-a", "Steam"])
                guard_log("Steam started again")
    if not steam_running():
        try:
            wanted, have = wanted_mapping(), current_mapping()
            changes = {a: t for a, (t, _) in wanted.items() if have.get(a) != t}
            if changes:
                cmd_map(changes, quiet=True, silent=True)
                guard_log("%d game(s) mapped by the rule" % len(changes))
        except (OSError, ValueError, SystemExit) as e:
            guard_log("PROBLEM: could not check the mappings: %s" % e)
    return 0


def cmd_guard_watch():
    """The guard as a process that stays: looks every two seconds, which costs a few file checks,
    and runs the guard proper when the switch or a tool is gone, when Steam's compatibility log
    has grown (Steam started, or is busy), when Steam's settings or app cache changed, and every
    five minutes. launchd's own file watching proved too slow and unsure for this: up to a
    minute for a deleted file, where Steam removes installs within half a minute of a bad start."""
    watched = [os.path.join(STEAM_ROOT, "logs", "compat_log.txt"), os.path.join(STEAM_ROOT, "config", "config.vdf"),
               os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf")]

    def stamps():
        out = []
        for path in watched:
            try:
                st = os.stat(path)
                out.append((st.st_mtime, st.st_size))
            except OSError:
                out.append(None)
        return out

    seen, last = None, 0
    while True:
        try:
            now = stamps()
            if switch_state()[1] != "linux" or not tools_installed() or now != seen or time.time() - last > 300:
                cmd_guard()
                seen, last = stamps(), time.time()
        except Exception as e:      # the watch must outlive anything a pass trips over
            guard_log("PROBLEM: %s: %s" % (type(e).__name__, e))
        time.sleep(2)


def cmd_guard_install():
    if install_tools() is None and not tools_installed():
        die("%s is missing or not writable; run setup first" % TOOLS_DIR)
    os.makedirs(HOME_DIR, exist_ok=True)
    here = os.path.dirname(os.path.abspath(__file__))
    script = os.path.join(HOME_DIR, "steamplay")
    if os.path.abspath(__file__) != script:
        shutil.copy2(os.path.abspath(__file__), script)
        dest = os.path.join(HOME_DIR, "steamplay-tools")
        if os.path.isdir(dest):
            shutil.rmtree(dest)
        shutil.copytree(os.path.join(here, "steamplay-tools"), dest)
    python = "/usr/bin/python3" if os.access("/usr/bin/python3", os.X_OK) else sys.executable
    plist = {
        "Label": GUARD_LABEL,
        "ProgramArguments": [python, script, "guard", "watch"],
        "EnvironmentVariables": {"STEAMPLAY_HOME": HOME_DIR, "STEAM_ROOT": STEAM_ROOT, "STEAMPLAY_TOOLS_DIR": TOOLS_DIR},
        "RunAtLoad": True,
        "KeepAlive": True,
        "ProcessType": "Background",
        "StandardOutPath": os.path.join(os.path.dirname(GUARD_LOG), "guard.out"),
        "StandardErrorPath": os.path.join(os.path.dirname(GUARD_LOG), "guard.out"),
    }
    os.makedirs(os.path.dirname(GUARD_LOG), exist_ok=True)
    os.makedirs(os.path.dirname(GUARD_PLIST), exist_ok=True)
    with open(GUARD_PLIST, "wb") as f:
        plistlib.dump(plist, f)
    domain = "gui/%d" % os.getuid()
    subprocess.run(["/bin/launchctl", "bootout", "%s/%s" % (domain, GUARD_LABEL)], stderr=subprocess.DEVNULL)
    # launchd is still taking the old job down when bootout returns, and refuses to load the
    # new one until it has (error 5): the guard must not stay unloaded, so try for a while
    for attempt in range(10):
        r = subprocess.run(["/bin/launchctl", "bootstrap", domain, GUARD_PLIST],
                           stderr=subprocess.DEVNULL if attempt < 9 else None)
        if not r.returncode:
            break
        time.sleep(1)
    if r.returncode:
        die("launchctl could not load %s" % GUARD_PLIST)
    print("the guard is installed: %s keeps %s guard watch running" % (GUARD_PLIST, script))
    print("it logs to %s" % GUARD_LOG)


def cmd_guard_remove():
    subprocess.run(["/bin/launchctl", "bootout", "gui/%d/%s" % (os.getuid(), GUARD_LABEL)], stderr=subprocess.DEVNULL)
    if os.path.exists(GUARD_PLIST):
        os.remove(GUARD_PLIST)
    print("the guard is removed. Nothing now puts the switch or the tools back if they go missing.")


def cmd_map(choices, dry_run=False, quiet=False, silent=False):
    """choices: {app id: tool name or None}. Writes them into config.vdf's CompatToolMapping."""
    if not dry_run and steam_running():
        die("quit Steam first: it rewrites its settings when it quits")
    path = os.path.join(STEAM_ROOT, "config", "config.vdf")
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        original = f.read()
    tree = vdf_parse(original)
    mapping = vdf_block(tree, ["InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"])
    names = {} if quiet else {appid: name for appid, name, _, _ in windows_games()}
    for appid, tool in sorted(choices.items()):
        old = next((v for k, v in mapping if k == str(appid) and isinstance(v, list)), None)
        oldname = next((v for k, v in old if k == "name"), None) if old else None
        mapping[:] = [kv for kv in mapping if kv[0] != str(appid)]
        if tool:
            mapping.append([str(appid), [["name", tool], ["config", ""], ["priority", "250"]]])
        if not quiet:
            print("%-11s %-9d %s: %s -> %s" % ("would map" if dry_run else "map", appid,
                                               names.get(appid, "default for all games" if appid == 0 else "?"),
                                               oldname or "(none)", tool or "(none)"))
    if dry_run:
        return
    os.makedirs(BACKUPS, exist_ok=True)
    shutil.copy2(path, os.path.join(BACKUPS, "config.vdf.%s" % time.strftime("%Y%m%d-%H%M%S")))
    write_file(path, "\n".join(vdf_dump(tree)) + "\n", encoding="utf-8", errors="surrogateescape")
    if not silent:
        print("%d mapping(s) written to %s" % (len(choices), path))


def cmd_play(appid):
    subprocess.run([OPEN, "-a", STEAMPLAY_APP, "--args", str(appid)], check=True)


def main(argv):
    if len(argv) >= 1 and argv[0] == "list":
        cmd_list()
    elif len(argv) >= 1 and argv[0] == "sync":
        cmd_sync("--dry-run" in argv[1:], "--remove" in argv[1:])
    elif len(argv) == 2 and argv[0] == "play" and argv[1].isdigit():
        cmd_play(int(argv[1]))
    elif argv in (["setup"], ["setup", "--dry-run"]):
        cmd_setup("--dry-run" in argv)
    elif argv == ["status"]:
        sys.exit(cmd_status())
    elif len(argv) == 3 and argv[0] == "prefer" and argv[1].isdigit() and argv[2] in ("native", "proton", "auto"):
        cmd_prefer(int(argv[1]), argv[2])
    elif argv == ["guard"]:
        sys.exit(cmd_guard())
    elif argv == ["guard", "watch"]:
        cmd_guard_watch()
    elif argv == ["guard", "install"]:
        cmd_guard_install()
    elif argv == ["guard", "remove"]:
        cmd_guard_remove()
    elif argv == ["tools"]:
        cmd_tools()
    elif len(argv) >= 1 and argv[0] == "links" and all(a.isdigit() for a in argv[1:]):
        sys.exit(cmd_links([int(a) for a in argv[1:]]))
    elif len(argv) >= 3 and argv[0] == "map" and len(argv[1:]) % 2 == 0 \
            and all(a.isdigit() for a in argv[1::2] if a != "--dry-run"):
        args = [a for a in argv[1:] if a != "--dry-run"]
        cmd_map({int(a): (None if t == "none" else t) for a, t in zip(args[::2], args[1::2])}, "--dry-run" in argv)
    elif len(argv) >= 1 and argv[0] == "hook" and all(a.isdigit() or a in ("--dry-run", "--remove") for a in argv[1:]):
        cmd_hook([int(a) for a in argv[1:] if a.isdigit()], "--remove" in argv[1:], "--dry-run" in argv[1:])
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
