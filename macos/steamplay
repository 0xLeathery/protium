def cmd_record(appid, start, logfile):
    """Called by steamplay-run.sh when a game's Wine session has ended: how long it ran and how it
    ended, from the log, as steamplay-try reads it."""
    try:
        with open(logfile, "rb") as f:
            log = f.read().decode("utf-8", errors="replace")
    except OSError:
        log = ""
    if "wine: abort() in native code" in log:
        end = "abort"
    elif any(s in log for s in ("wine: Unhandled", "Exception frame is not in stack limits", "virtual_setup_exception stack overflow")):
        end = "crash"
    elif re.search(r"RtlpWaitForCriticalSection.*wait timed out", log):
        end = "hang"
    else:
        end = "ended"
    loaded = sorted({GRAPHICS_DLLS[m.lower()] for m in re.findall(r'\\\\([A-Za-z0-9_\-]+\.dll)" at ', log) if m.lower() in GRAPHICS_DLLS}
                    | ({"dotnet"} if re.search(r'\\\\mscoree\.dll" at ', log, re.I) else set()))
    add_result({"app": appid, "time": time.strftime("%Y-%m-%dT%H:%M:%S"), "by": "run",
                "seconds": max(0, int(time.time()) - start), "end": end, "loaded": loaded,
                "protium": os.environ.get("PROTIUM_VERSION", "")})
    return 0


