PROTON, NATIVE = "proton-macos", "macos-native"


def app_cache():
    """Steam's cache of app metadata, appcache/appinfo.vdf: {app id: {name, type, oslist, osextended,
    deck, deck_tests, thirdparty, launch}}."""
    path = os.path.join(STEAM_ROOT, "appcache", "appinfo.vdf")
    with open(path, "rb") as f:
        d = f.read()
    magic, = struct.unpack_from("<I", d, 0)
    if magic != 0x07564429:
        die("%s has format %#x, not the one this reads (0x7564429)" % (path, magic))
    table, = struct.unpack_from("<q", d, 8)
    count, = struct.unpack_from("<I", d, table)
    strings, pos = [], table + 4
    for _ in range(count):
        end = d.index(b"\0", pos)
        strings.append(d[pos:end].decode("utf-8", "replace"))
        pos = end + 1

    def block(pos):
        out = {}
        while True:
            kind = d[pos]
            pos += 1
            if kind == 8:
                return out, pos
            key = strings[struct.unpack_from("<I", d, pos)[0]]
            pos += 4
            if kind == 0:
                value, pos = block(pos)
            elif kind == 1:
                end = d.index(b"\0", pos)
                value, pos = d[pos:end].decode("utf-8", "replace"), end + 1
            elif kind == 2:
                value, pos = struct.unpack_from("<i", d, pos)[0], pos + 4
            elif kind == 7:
                value, pos = struct.unpack_from("<Q", d, pos)[0], pos + 8
            else:
                raise ValueError("value type %d" % kind)
            out[key] = value

    apps, pos = {}, 16
    while pos < table:
        appid, size = struct.unpack_from("<II", d, pos)
        if not appid:
            break
        try:    # after id and size: state, time, token, a hash, change number, a hash
            root = block(pos + 8 + 60)[0]
            common = root.get("appinfo", root).get("common", {})
            info = root.get("appinfo", root)
            deck = common.get("steam_deck_compatibility", {})
            launch = [str(l.get("executable", "")) for l in info.get("config", {}).get("launch", {}).values()
                      if isinstance(l, dict) and "windows" in str(l.get("config", {}).get("oslist", "windows"))]
            apps[appid] = {"name": str(common.get("name", "?")), "type": str(common.get("type", "")).lower(),
                           "oslist": [x for x in str(common.get("oslist", "")).split(",") if x],
                           "osextended": [x for x in str(common.get("osextended", "")).split(",") if x],
                           # for "discover": Valve's Steam Deck verdict (3 Verified, 2 Playable,
                           # 1 Unsupported) and the tests behind it that did not pass
                           "deck": deck.get("category", 0),
                           "deck_tests": [(t.get("display"), str(t.get("token", "")).replace("#SteamDeckVerified_TestResult_", ""))
                                          for t in deck.get("tests", {}).values() if isinstance(t, dict) and t.get("display") in (1, 2, 3)],
                           "thirdparty": bool(info.get("extended", {}).get("thirdpartycdkey")),
                           "installdir": str(info.get("config", {}).get("installdir", "")),
                           "launch": [e for e in launch if e.lower().endswith(".exe")]}
        except (ValueError, IndexError, struct.error):
            pass
        pos += 8 + size
    return apps


def rule(app):
    """The tool for a game by the rule, and why."""
    if "macos" in app["oslist"]:
        if "macosapplesilicon" in app["osextended"]:
            return NATIVE, "has a Mac build for Apple Silicon"
        if "macos64" in app["osextended"]:
            return NATIVE, "has a 64-bit Mac build (runs under Rosetta)"
        return PROTON, "its Mac build is 32-bit, which this macOS cannot run"
    if "linux" in app["oslist"]:
        return PROTON, "no Mac build (and its Linux build must not be chosen)"
    return PROTON, "Windows only"


def read_choices():
    try:
        with open(CHOICES) as f:
            return {int(k): v for k, v in json.load(f).items() if v in ("native", "proton")}
    except (OSError, ValueError):
        return {}


def switch_state():
    """The platform each steam_dev.cfg sets, or None."""
    out = []
    for path in SWITCH_FILES:
        try:
            with open(path) as f:
                found = [l.split()[1] for l in f.read().splitlines() if l.startswith(SWITCH + " ") and len(l.split()) > 1]
        except OSError:
            found = []
        out.append(found[-1] if found else None)
    return out


def write_switch(platform):
    for path in SWITCH_FILES:
        if not os.path.isdir(os.path.dirname(path)):
            continue
        try:
            with open(path) as f:
                lines = [l for l in f.read().splitlines() if not l.startswith(SWITCH + " ")]
        except OSError:
            lines = []
        write_file(path, "\n".join(lines + ["%s %s" % (SWITCH, platform)]) + "\n")


def tools_installed():
    return all(os.access(os.path.join(TOOLS_DIR, t, "run"), os.X_OK) for t in TOOLS)


def current_mapping():
    path = os.path.join(STEAM_ROOT, "config", "config.vdf")
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        tree = vdf_parse(f.read())
    mapping = vdf_block(tree, ["InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping"])
    return {int(k): next((x for n, x in v if n == "name"), None) for k, v in mapping if isinstance(v, list) and k.isdigit()}


def wanted_mapping():
    """{app id: (tool, why)} for the default and every cached game that needs its own entry."""
    choices = read_choices()
    out = {0: (PROTON, "the default, for games Steam's cache does not have yet")}
    for appid, app in app_cache().items():
        if app["type"] not in ("game", "demo", "application", "beta") or not app["oslist"]:
            continue
        tool, why = rule(app)
        if appid in choices:
            tool, why = (NATIVE if choices[appid] == "native" else PROTON), "your choice"
        if tool == NATIVE or app["oslist"] != ["windows"] or appid in choices:
            out[appid] = (tool, why)
    return out


def cmd_setup(dry_run):
    if steam_ready():
        stop(steam_ready())
    if not dry_run and steam_running():
        stop("Quit Steam first, then try again.")
    wanted = wanted_mapping()
    have = current_mapping()
    changes = {a: t for a, (t, _) in wanted.items() if have.get(a) != t}
    native = sum(1 for t, _ in wanted.values() if t == NATIVE)
    print("%d games will use their Mac version. %d games that have a Mac or Linux version will use their Windows "
          "version instead. All other games use their Windows version." % (native, len(wanted) - native - 1))
    cache = app_cache()
    names = {a: cache[a]["name"] for a in cache}
    for appid, _, lib, _ in installed_apps():
        if appid in cache and cache[appid]["type"] in ("game", "demo", "application", "beta"):
            tool, why = wanted.get(appid, (PROTON, "Windows only"))
            print("  installed  %-9d %-45s %s: %s" % (appid, names.get(appid, "?")[:45], tool, why))
    if dry_run:
        print("would write %d mapping(s), the switch to linux, and the tools into %s" % (len(changes), TOOLS_DIR))
        return
    cmd_tools()
    write_switch("linux")
    print("Steam is set to offer Windows games.")
    if changes:
        cmd_map(changes, quiet=True)
    else:
        print("Steam's game settings are already up to date.")
    hooked = hooked_apps()
    if hooked:
        cmd_hook(hooked, True, False)
    print("Steam is set up.")


def cmd_uninstall(dry_run):
    """Undoes setup: the guard, the tools, the switch, the games' mappings to the tools and the
    launch options hook set. Game files, prefixes (compatdata) and SteamPlay's own folder stay."""
    if not dry_run and steam_running():
        stop("Quit Steam first, then try again.")
    # a Steam that never started has no settings to undo; the rest is still taken out
    have_settings = os.path.isfile(os.path.join(STEAM_ROOT, "config", "config.vdf"))
    mapped = sorted(a for a, t in current_mapping().items() if t in (PROTON, NATIVE)) if have_settings else []
    hooked = hooked_apps() if signed_in_user_config() else []
    present = [t for t in TOOLS if os.path.isdir(os.path.join(TOOLS_DIR, t))]
    if dry_run:
        print("would remove the guard, the tools %s from %s, the switch, %d mapping(s) and %d hook(s)"
              % (", ".join(present) or "(none)", TOOLS_DIR, len(mapped), len(hooked)))
        return
    if os.environ.get("STEAMPLAY_FAKE_STEAM"):
        print("(a copy of a Steam folder: the guard, which is this user's, is left alone)")
    elif not os.environ.get("STEAMPLAY_KEEP_GUARD"):    # set by the guard's own job, which ends itself
        cmd_guard_remove()
    for tool in present:
        shutil.rmtree(os.path.join(TOOLS_DIR, tool))
        print("Removed %s." % os.path.join(TOOLS_DIR, tool))
    for path in SWITCH_FILES:
        try:
            with open(path) as f:
                lines = f.read().splitlines()
        except OSError:
            continue
        kept = [l for l in lines if not l.startswith(SWITCH + " ")]
        if kept != lines:
            if any(l.strip() for l in kept):
                write_file(path, "\n".join(kept) + "\n")
            else:
                os.remove(path)
            print("Removed Protium's setting from %s." % path)
    if mapped:
        cmd_map({a: None for a in mapped}, quiet=True)
        print("%d game(s) no longer use Protium's tools." % len(mapped))
    if hooked:
        cmd_hook(hooked, True, False)
    print("Done. The next time Steam starts it will show only Mac games again, and it will delete the Windows\n"
          "games it installed through Protium. Their save data in steamapps/compatdata is kept.")


def cmd_prefer(appid, choice):
    if steam_running():
        die("quit Steam first: it rewrites its settings when it quits")
    cache = app_cache()
    if appid not in cache:
        die("Steam's cache has no app %d" % appid)
    choices = read_choices()
    choices.pop(appid, None)
    if choice != "auto":
        if choice == "native" and "macos" not in cache[appid]["oslist"]:
            die("%s has no Mac build" % cache[appid]["name"])
        choices[appid] = choice
    os.makedirs(os.path.dirname(CHOICES), exist_ok=True)
    with open(CHOICES, "w") as f:
        json.dump({str(k): v for k, v in sorted(choices.items())}, f, indent=1)
    tool, why = wanted_mapping().get(appid, (None, "Windows only: Proton by default"))
    print("%d %s: %s (%s)" % (appid, cache[appid]["name"], tool or PROTON, why))
    cmd_map({appid: tool}, quiet=True)


def installed_apps():
    """(app id, name, library, installed depot ids) of every app with a manifest."""
    out = []
    for lib in libraries():
        apps = os.path.join(lib, "steamapps")
        for entry in sorted(os.listdir(apps)):
            m = re.fullmatch(r"appmanifest_(\d+)\.acf", entry)
            if not m:
                continue
            with open(os.path.join(apps, entry), encoding="utf-8", errors="replace") as f:
                tree = vdf_parse(f.read())
            state = vdf_block(tree, ["AppState"])
            name = next((v for k, v in state if k == "name" and isinstance(v, str)), m.group(1))
            depots = [k for k, v in vdf_block(state, ["InstalledDepots"]) if isinstance(v, list)]
            out.append((int(m.group(1)), name, lib, depots))
    return out


def hooked_apps():
    """App ids whose launch option is hook's."""
    path = os.path.join(steam_user_config(), "localconfig.vdf")
    with open(path, encoding="utf-8", errors="surrogateescape") as f:
        tree = vdf_parse(f.read())
    apps = vdf_block(tree, ["UserLocalConfigStore", "Software", "Valve", "Steam", "apps"])
    return [int(k) for k, v in apps if isinstance(v, list) and k.isdigit()
            and any(n == "LaunchOptions" and "steamplay-launch" in x for n, x in v if isinstance(x, str))]


def cmd_status():
    if steam_ready():
        stop(steam_ready())
    problems = []
    root, bundle = switch_state()
    print("Steam is %s" % ("running" if steam_running() else "not running"))
    print("Platform setting: %s (in Steam's app folder, the one Steam reads); %s (in Steam's data folder)"
          % (bundle or "none", root or "none"))
    if bundle != "linux":
        problems.append("Windows games are switched off in Steam. At its next start Steam will treat installed "
                        "Windows games as broken.")
    present = [t for t in TOOLS if os.access(os.path.join(TOOLS_DIR, t, "run"), os.X_OK)]
    print("Tools in %s: %s" % (TOOLS_DIR, ", ".join(present) or "none"))
    if len(present) != len(TOOLS):
        problems.append("Protium's tools are missing from Steam, so Steam will treat the games that use them as Linux games.")
    have, wanted, cache = current_mapping(), wanted_mapping(), app_cache()
    print("Default tool for games not listed below: %s" % (have.get(0) or "none"))
    if have.get(0) != PROTON:
        problems.append("Steam has no default tool set for Windows games.")
    stale = sum(1 for a, (t, _) in wanted.items() if have.get(a) != t)
    print("Games assigned to Protium's tools: %d (%d still to update)" % (sum(1 for t in have.values() if t in TOOLS), stale))
    if stale:
        problems.append("%d game(s) haven't been assigned a tool yet. They may be new." % stale)
    for appid, name, lib, depots in installed_apps():
        if appid not in cache or cache[appid]["type"] not in ("game", "demo", "application", "beta"):
            continue
        tool, why = wanted.get(appid, (PROTON, "Windows only"))
        mapped = have.get(appid) or ("%s (default)" % have.get(0) if have.get(0) else "none")
        print("  %-9d %-42s %-13s %s; mapped: %s; depots: %s" % (appid, name[:42], tool, why, mapped, " ".join(depots) or "none"))
    loaded = subprocess.run(["/bin/launchctl", "print", "gui/%d/%s" % (os.getuid(), GUARD_LABEL)],
                            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0
    print("Background helper: %s" % ("running" if loaded else "not running, so nothing repairs Steam's setup if it gets lost"))
    if steam_running():
        print("Steam's log for this session: %s" % session_state())
    if guard_gave_up():
        problems.append("Steam started without Protium's tools %d times in a row, so the background helper stopped "
                        "restarting it." % GUARD_TRIES)
    for p in problems:
        print("PROBLEM: " + p)
    if problems:
        print("To fix this, quit Steam and press Repair (or run: %s setup)." % os.path.abspath(__file__))
    return 1 if problems else 0


def app_contents():
    """Protium.app's Contents folder when this script is the app's copy
    (Contents/Resources/steamplay/steamplay, with the runtime in Contents/SharedSupport/runtime),
    else None: a checkout or the guard's copy."""
    contents = os.path.dirname(os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
    if os.path.basename(contents) == "Contents" \
            and os.access(os.path.join(contents, "SharedSupport", "runtime", "bin", "wine"), os.X_OK):
        return contents
    return None


def install_paths():
    """What the installed tools need to know, as a dict: macos_dir (where steamplay-launch is),
    and when known wine_install, python and tool_log. Run from a checkout or from Protium.app,
    this copy records it in INSTALL_JSON; run from the guard's copy, it reads it from there.
    {} when neither is known."""
    here = os.path.dirname(os.path.abspath(__file__))
    if os.access(os.path.join(here, "steamplay-launch"), os.X_OK):
        contents = app_contents()
        if contents:
            python = os.path.join(contents, "SharedSupport", "python", "bin", "python3")
            paths = {"macos_dir": here,
                     "wine_install": os.path.join(contents, "SharedSupport", "runtime"),
                     "python": python if os.access(python, os.X_OK) else sys.executable,
                     "tool_log": os.path.expanduser("~/Library/Logs/Protium/steamplay-tools.log")}
        else:
            paths = {"macos_dir": here, "build_root": BUILD_ROOT,
                     "tool_log": os.path.join(BUILD_ROOT, "evidence", "steamplay", "probe.log")}
        try:
            os.makedirs(HOME_DIR, exist_ok=True)
            write_file(INSTALL_JSON, json.dumps(paths, indent=1) + "\n")
        except OSError:
            pass
        return paths
    try:
        with open(INSTALL_JSON) as f:
            paths = json.load(f)
        if not isinstance(paths, dict):
            return {}
        if "tool_log" not in paths and paths.get("build_root"):     # written before tool_log
            paths["tool_log"] = os.path.join(paths["build_root"], "evidence", "steamplay", "probe.log")
        return paths
    except (OSError, ValueError):
        return {}


def install_tools():
    """Copies the tools into the folder Steam scans, each with a protium.conf that tells its run
    script where steamplay-launch, the Wine install, Python and its log are. Returns what it
    installed, or None when the folder is missing or not writable."""
    if not os.path.isdir(TOOLS_DIR) or not os.access(TOOLS_DIR, os.W_OK):
        return None
    paths = install_paths()
    conf = ["# Written by macos/steamplay when it installed this tool. The environment wins over it."]
    for var, key in (("PROTON_DIR", "macos_dir"), ("WINE_INSTALL", "wine_install"),
                     ("PROTIUM_PYTHON", "python"), ("STEAMPLAY_TOOL_LOG", "tool_log")):
        if paths.get(key):
            conf.append('[ -n "${%s:-}" ] || %s=%s' % (var, var, shlex.quote(paths[key])))
            conf.append("export " + var)
    if paths.get("tool_log"):
        os.makedirs(os.path.dirname(paths["tool_log"]), exist_ok=True)
    for tool in TOOLS:
        target = os.path.join(TOOLS_DIR, tool)
        if os.path.isdir(target):
            shutil.rmtree(target)
        shutil.copytree(os.path.join(TOOLS_SRC, tool), target)
        if paths.get("macos_dir"):
            write_file(os.path.join(target, "protium.conf"), "\n".join(conf) + "\n")
    return TOOLS


