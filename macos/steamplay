PROTONDB_RAW = "https://raw.githubusercontent.com/bdefore/protondb-data/master/reports/"
VERDICTS = ("works", "plays-with-problems", "menu-only", "broken")
GOOD_RUN_SECONDS = 600      # a run this long that ended by itself counts as "ran"
MONTHS = "jan feb mar apr may jun jul aug sep oct nov dec".split()


def read_json(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def cmd_data_update():
    """Fetches the public datasets whole: the anti-cheat list and ProtonDB's newest monthly export
    (Open Database License; kept on this Mac, not redistributed), reduced to a line per game."""
    import tarfile
    os.makedirs(DATA_DIR, exist_ok=True)
    curl(ANTICHEAT_URL, os.path.join(DATA_DIR, "anticheat.json.part"))
    games = read_json(os.path.join(DATA_DIR, "anticheat.json.part"), None)
    if not isinstance(games, list):
        die("the anti-cheat list is not the JSON list it used to be")
    os.replace(os.path.join(DATA_DIR, "anticheat.json.part"), os.path.join(DATA_DIR, "anticheat.json"))
    print("anti-cheat list: %d games" % len(games))

    def when(name):     # reports_nov1_2026.tar.gz -> (2026, 11, 1)
        m = re.fullmatch(r"reports_([a-z]{3})(\d+)_(\d{4})\.tar\.gz", name)
        return (int(m.group(3)), MONTHS.index(m.group(1)) + 1, int(m.group(2))) if m and m.group(1) in MONTHS else None
    listing = json.loads(curl(PROTONDB_LIST).decode("utf-8", errors="replace"))
    names = sorted((n for n in (e.get("name", "") for e in listing if isinstance(e, dict)) if when(n)), key=when)
    if not names:
        die("no ProtonDB export found in its repository")
    newest, summary_path = names[-1], os.path.join(DATA_DIR, "protondb.json")
    if read_json(summary_path, {}).get("source") == newest:
        print("ProtonDB: %s is already here" % newest)
        return 0
    tar_path = os.path.join(DATA_DIR, "protondb.tar.gz.part")
    print("downloading ProtonDB's export %s" % newest)
    curl(PROTONDB_RAW + newest, tar_path)
    # the export is one JSON list of half a gigabyte: its reports are read one at a time
    since = time.time() - 3 * 365 * 86400
    apps, decoder = {}, json.JSONDecoder()
    with tarfile.open(tar_path) as tar:
        member = next(m for m in tar.getmembers() if m.name.endswith(".json"))
        f = tar.extractfile(member)
        buf, started = "", False
        while True:
            chunk = f.read(1 << 22)
            buf += chunk.decode("utf-8", errors="replace")
            while True:
                buf = buf.lstrip(" \r\n\t,")
                if not started:
                    if not buf.startswith("["):
                        break
                    buf, started = buf[1:], True
                    continue
                if not buf or buf[0] == "]":
                    break
                try:
                    report, end = decoder.raw_decode(buf)
                except ValueError:
                    break       # the rest of this report is in the next chunk
                buf = buf[end:]
                appid = str(report.get("app", {}).get("steam", {}).get("appId", ""))
                answers = report.get("responses", {})
                if not appid.isdigit() or report.get("timestamp", 0) < since or answers.get("verdict") not in ("yes", "no"):
                    continue
                a = apps.setdefault(appid, [0, 0, 0, 0])    # reports, yes, tinkered, second launcher
                a[0] += 1
                a[1] += answers.get("verdict") == "yes"
                a[2] += answers.get("tinkerOverride") == "yes"
                a[3] += answers.get("secondaryLauncher") == "yes"
            if not chunk:
                break
    write_file(summary_path, json.dumps({"source": newest, "apps": apps}))
    os.remove(tar_path)
    print("ProtonDB: %d games with reports of the last three years" % len(apps))
    return 0


# ---- an installed game's files

def pe_info(path):
    """What a Windows program's header says: {"bits", "imports" (DLL names, lower case),
    "managed" (a .NET program)}, or None if it is not one."""
    import mmap
    try:
        with open(path, "rb") as f:
            d = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
    except (OSError, ValueError):
        return None
    try:
        if d[:2] != b"MZ":
            return None
        pe, = struct.unpack_from("<I", d, 0x3c)
        if d[pe:pe + 4] != b"PE\0\0":
            return None
        nsections, = struct.unpack_from("<H", d, pe + 6)
        optsize, = struct.unpack_from("<H", d, pe + 20)
        opt = pe + 24
        magic, = struct.unpack_from("<H", d, opt)
        if magic not in (0x10b, 0x20b):
            return None
        dirs = opt + (96 if magic == 0x10b else 112)
        ndirs, = struct.unpack_from("<I", d, dirs - 4)
        sections = [struct.unpack_from("<IIII", d, opt + optsize + 40 * i + 8) for i in range(nsections)]

        def offset(rva):
            for vsize, vaddr, rawsize, rawptr in sections:
                if vaddr <= rva < vaddr + max(vsize, rawsize):
                    return rawptr + rva - vaddr
            return None

        def directory(i):
            return struct.unpack_from("<II", d, dirs + 8 * i) if i < ndirs else (0, 0)

        def names(index, size, name_at):
            out, (rva, _) = set(), directory(index)
            pos = offset(rva) if rva else None
            while pos is not None and pos + size <= len(d) and len(out) < 512:
                entry = d[pos:pos + size]
                if not any(entry):
                    break
                name = offset(struct.unpack_from("<I", entry, name_at)[0])
                if name is not None:
                    out.add(d[name:d.find(b"\0", name, name + 256)].decode("ascii", "replace").lower())
                pos += size
            return out
        return {"bits": 32 if magic == 0x10b else 64,
                "imports": names(1, 20, 12) | names(13, 32, 4),     # imports and delayed imports
                "managed": directory(14)[0] != 0}
    except (struct.error, IndexError, ValueError):
        return None
    finally:
        d.close()


def pe_version(path):
    """The ProductVersion a Windows program's version resource gives, or ""."""
    import mmap
    try:
        with open(path, "rb") as f:
            d = mmap.mmap(f.fileno(), 0, access=mmap.ACCESS_READ)
    except (OSError, ValueError):
        return ""
    try:
        key = "ProductVersion".encode("utf-16-le")
        at = d.find(key)
        if at < 0:
            return ""
        pos = at + len(key)
        while pos + 2 <= len(d) and d[pos:pos + 2] == b"\0\0":
            pos += 2
        end = pos
        while end + 2 <= len(d) and d[end:end + 2] != b"\0\0" and end - pos < 128:
            end += 2
        return d[pos:end].decode("utf-16-le", "replace").strip()
    finally:
        d.close()


GRAPHICS_DLLS = {"d3d9.dll": "d3d9", "d3d10.dll": "d3d10", "d3d10_1.dll": "d3d10", "d3d11.dll": "d3d11",
                 "d3d12.dll": "d3d12", "vulkan-1.dll": "vulkan", "opengl32.dll": "opengl"}


def scan_game(folder, launch_exes):
    """What an installed game's files say: {"apis", "engine", "bits", "dotnet", "anticheat",
    "browser", "exe"}. It reads headers of the programs Steam starts and of the largest ones."""
    exes, dlls, names, dirs = [], [], set(), set()
    count, base_depth = 0, folder.rstrip("/").count("/")
    for root, subdirs, files in os.walk(folder):
        if root.count("/") - base_depth >= 6 or count > 40000:
            subdirs[:] = []
        for sub in subdirs:
            dirs.add(sub.lower())
        for name in files:
            count += 1
            low = name.lower()
            names.add(low)
            if low.endswith(".exe") or low.endswith(".dll"):
                path = os.path.join(root, name)
                try:
                    (exes if low.endswith(".exe") else dlls).append((os.path.getsize(path), path))
                except OSError:
                    pass
    chosen = [os.path.join(folder, e.replace("\\", "/")) for e in launch_exes]
    chosen = [p for p in chosen if os.path.isfile(p)]
    skip = ("unitycrashhandler", "crashreport", "unins", "vc_redist", "vcredist", "dxsetup", "dotnet", "installer", "setup")
    for _, path in sorted(exes, reverse=True):
        if len(chosen) >= 4:
            break
        if path not in chosen and not any(s in os.path.basename(path).lower() for s in skip):
            chosen.append(path)
    # the DLLs next to those programs draw for many engines (UnityPlayer.dll, an engine's renderer)
    beside = {os.path.dirname(p) for p in chosen}
    chosen_dlls = [p for size, p in sorted(dlls, reverse=True) if os.path.dirname(p) in beside][:40]
    apis, bits, dotnet = set(), None, False
    for i, path in enumerate(chosen + chosen_dlls):
        info = pe_info(path)
        if not info:
            continue
        if i < len(chosen):
            bits = bits or info["bits"]
            dotnet = dotnet or info["managed"] or "mscoree.dll" in info["imports"]
        apis |= {GRAPHICS_DLLS[d] for d in info["imports"] if d in GRAPHICS_DLLS}
    dotnet = dotnet or any(n.endswith(".runtimeconfig.json") for n in names)
    engine = ""
    if "unityplayer.dll" in names:
        player = next(p for _, p in dlls if os.path.basename(p).lower() == "unityplayer.dll")
        engine = ("unity " + pe_version(player).split(".")[0]).strip()
        apis = apis - {"opengl", "vulkan"} or {"d3d11"}     # Unity for Windows draws with Direct3D 11 unless told otherwise
        dotnet = False      # Unity brings its own Mono or IL2CPP
    elif any(os.path.basename(p).lower().endswith("-shipping.exe") for _, p in exes) or ("engine" in dirs and "binaries" in dirs):
        shipping = next((p for _, p in sorted(exes, reverse=True) if p.lower().endswith("-shipping.exe")), None)
        major = pe_version(shipping).split(".")[0] if shipping else ""
        engine = "unreal " + (major if major in ("4", "5") else "?")
    elif any(n.endswith(".pck") for n in names) and any(n.endswith(".pck") and n[:-4] + ".exe" in names for n in names):
        engine = "godot"
    elif "data.win" in names:
        engine = "gamemaker"
    elif "renpy" in dirs:
        engine = "renpy"
    elif "engine.dll" in names and ("vgui2.dll" in names or "tier0.dll" in names):
        engine = "source"
    elif "nw.dll" in names or "app.asar" in names:
        engine = "web"
    elif any(n.endswith(".jar") for n in names) and ("jre" in dirs or "java" in dirs or "runtime" in dirs):
        engine = "java"
    anticheat = sorted(label for label, hit in (
        ("Easy Anti-Cheat", "easyanticheat" in dirs or any(n.startswith("easyanticheat") for n in names)),
        ("BattlEye", "battleye" in dirs or any(n.startswith("beclient") or n.startswith("beservice") for n in names)),
        ("EA anticheat", any(n.startswith("eaanticheat") for n in names)),
        ("GameGuard", "gameguard" in dirs or "gameguard.des" in names),
        ("XIGNCODE3", any(n.startswith("xigncode") or n == "x3.xem" for n in names))) if hit)
    return {"apis": sorted(apis), "engine": engine, "bits": bits, "dotnet": dotnet, "anticheat": anticheat,
            "browser": "libcef.dll" in names, "exe": os.path.basename(chosen[0]) if chosen else ""}


def installed_games(cache):
    """{app id: (folder, build id)} of every installed app whose folder is there, and, with build
    id "files only", of every game whose folder is in a library though Steam has no record of it
    (Steam drops the record of a Windows build it stops offering and leaves the files)."""
    out, by_dir = {}, {}
    for appid, app in cache.items():
        if app.get("installdir") and app["type"] in ("game", "demo"):
            by_dir.setdefault(app["installdir"].lower(), appid)
    for lib in libraries():
        apps = os.path.join(lib, "steamapps")
        if os.path.isdir(os.path.join(apps, "common")):
            for entry in os.listdir(os.path.join(apps, "common")):
                if entry.lower() in by_dir:
                    out[by_dir[entry.lower()]] = (os.path.join(apps, "common", entry), "files only")
        for entry in os.listdir(apps):
            m = re.fullmatch(r"appmanifest_(\d+)\.acf", entry)
            if not m:
                continue
            with open(os.path.join(apps, entry), encoding="utf-8", errors="replace") as f:
                state = dict((k.lower(), v) for k, v in vdf_block(vdf_parse(f.read()), ["AppState"]) if isinstance(v, str))
            folder = os.path.join(apps, "common", state.get("installdir", ""))
            if state.get("installdir") and os.path.isdir(folder):
                out[int(m.group(1))] = (folder, state.get("buildid", ""))
    return out


def scans(cache, installed):
    """The file scan of each installed game, read again only when the game's build changed."""
    path = os.path.join(DATA_DIR, "scan.json")
    kept, changed = read_json(path, {}), False
    for appid, (folder, build) in installed.items():
        if appid not in cache or cache[appid].get("windows_only_tool"):
            continue
        entry = kept.get(str(appid))
        if entry and entry.get("build") == build and entry.get("folder") == folder:
            continue
        found = scan_game(folder, cache[appid].get("launch", []))
        found.update(build=build, folder=folder)
        kept[str(appid)], changed = found, True
    if changed:
        os.makedirs(DATA_DIR, exist_ok=True)
        write_file(path, json.dumps(kept, indent=1))
    return {int(k): v for k, v in kept.items() if int(k) in installed}


