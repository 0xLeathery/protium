# ---- updating the app
#
# "update" replaces the app this script is in with a newer release. What it installs must be
# ours: an app with Protium's identifier, signed with our Developer ID, notarized by Apple (so
# Gatekeeper accepts it), and of the version that was announced, which must be newer than this
# one. Every test is made on the disk image as downloaded and again on the copy that is about
# to be put in place, and a failure installs nothing.

BUNDLE_ID = "com.redshot.protium"
APP_REQUIREMENT = ('anchor apple generic and identifier "%s" and certificate 1[field.1.2.840.113635.100.6.2.6] exists '
                   'and certificate leaf[field.1.2.840.113635.100.6.1.13] exists and certificate leaf[subject.OU] = "922Z3D8FB9"' % BUNDLE_ID)
UPDATE_CACHE = os.environ.get("PROTIUM_UPDATE_CACHE") or os.path.expanduser("~/Library/Caches/Protium")
UPDATE_PENDING = os.path.join(HOME_DIR, "update-pending.json")


def this_app():
    """The Protium.app this script is in, or None in a checkout. PROTIUM_APP names another one to
    act for: macos/tests/check-update.sh runs this checkout's script for a copy of the released
    app, since a script put into the copy would break its seal (macOS then kills what is started
    from it and moves the app to the Trash)."""
    if os.environ.get("PROTIUM_APP"):
        return os.environ["PROTIUM_APP"].rstrip("/")
    path = os.path.abspath(__file__)
    marker = ".app/Contents/Resources/steamplay/"
    return path[:path.index(marker) + 4] if marker in path else None


def games_running(app):
    """Programs running from the app's Wine: a game, or what a game left behind."""
    runtime = os.path.join(app, "Contents", "SharedSupport", "runtime") + "/"
    r = subprocess.run(["/bin/ps", "-axo", "pid=,comm="], stdout=subprocess.PIPE, universal_newlines=True, errors="replace")
    return [line.split(None, 1)[1] for line in r.stdout.splitlines() if len(line.split(None, 1)) == 2 and line.split(None, 1)[1].startswith(runtime)]


def app_problem(app, version, current):
    """Why this app must not be installed as release `version` over `current`, or None."""
    import plistlib
    if not os.path.isdir(app) or os.path.islink(app):
        return "there is no Protium.app in it"
    r = subprocess.run(["/usr/bin/codesign", "--verify", "--deep", "--strict", "-R=" + APP_REQUIREMENT, app],
                       stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r.returncode != 0:
        return "it is not signed by Protium's developer, or was changed after signing (%s)" % (r.stderr.decode(errors="replace").strip().split("\n") or [""])[-1]
    r = subprocess.run(["/usr/sbin/spctl", "--assess", "--type", "execute", app], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if r.returncode != 0:
        return "macOS does not accept it (not notarized by Apple?): %s" % r.stderr.decode(errors="replace").strip()
    try:
        with open(os.path.join(app, "Contents", "Info.plist"), "rb") as f:
            info = plistlib.load(f)
    except Exception:
        return "its Info.plist cannot be read"
    if info.get("CFBundleIdentifier") != BUNDLE_ID:
        return "it is not Protium (%s)" % info.get("CFBundleIdentifier")
    found = info.get("CFBundleShortVersionString", "")
    if not re.fullmatch(r"\d+\.\d+\.\d+", version) or found != version:
        return "it is version %s, not the %s that was announced" % (found or "unknown", version)
    if not current or version_key(found) <= version_key(current):
        return "version %s is not newer than this one (%s)" % (found, current or "unknown")
    return None


def with_image(image, action):
    """Mounts a disk image read-only where nothing else looks, runs action(the Protium.app in
    it) and takes it away again. Returns action's answer, or a reason when it cannot be mounted."""
    import tempfile
    mount = tempfile.mkdtemp(prefix="protium-update-")
    try:
        r = subprocess.run(["/usr/bin/hdiutil", "attach", "-nobrowse", "-readonly", "-noautoopen", "-mountpoint", mount, image],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r.returncode != 0:
            return "the disk image cannot be opened: %s" % (r.stderr.decode(errors="replace").strip().split("\n") or [""])[-1]
        try:
            return action(os.path.join(mount, "Protium.app"))
        finally:
            subprocess.run(["/usr/bin/hdiutil", "detach", "-quiet", "-force", mount], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    finally:
        try:
            os.rmdir(mount)
        except OSError:
            pass


def refused(why, image=None):
    if image and os.path.dirname(os.path.abspath(image)) == UPDATE_CACHE and os.path.exists(image):
        os.remove(image)        # a download that failed its tests does not stay
    print("refused: %s" % why)
    return 1


def cmd_update_verify(image, version):
    problem = with_image(image, lambda app: app_problem(app, version, protium_version()))
    if problem:
        return refused(problem, image)
    print("ok %s is Protium %s, signed and notarized" % (os.path.basename(image), version))
    return 0


def cmd_update_fetch():
    """Downloads the newest release's disk image and tests it. Prints "ok fetched <file>
    <version>". PROTIUM_UPDATE_IMAGE names a file to take instead of downloading, for the checks;
    it is tested like a download."""
    app = this_app()
    if not app:
        return refused("this is a checkout, update it with git")
    newer = newer_releases(now=True)
    if not newer:
        return refused("there is no newer version than %s" % (protium_version() or "this one"))
    release = newer[0]
    if not release["download"]:
        return refused("release %s has no disk image of ours to download; see %s" % (release["version"], release["page"]))
    running = games_running(app)
    if running:
        return refused("a game is running from this Protium (%s); quit it first" % os.path.basename(running[0]))
    os.makedirs(UPDATE_CACHE, exist_ok=True)
    image = os.path.join(UPDATE_CACHE, "Protium-%s.dmg" % release["version"])
    if os.environ.get("PROTIUM_UPDATE_IMAGE"):
        shutil.copyfile(os.environ["PROTIUM_UPDATE_IMAGE"], image)
    else:
        print("downloading Protium %s" % release["version"])
        sys.stdout.flush()
        curl(release["download"], image)
    problem = with_image(image, lambda found: app_problem(found, release["version"], protium_version()))
    if problem:
        return refused(problem, image)
    print("ok fetched %s %s" % (image, release["version"]))
    return 0


# Puts the new app where the old one is, once the old one has quit, and puts the old one back
# when the new one does not start: $1 the app, $2 the new copy next to it, $3 where the old one
# waits, $4 the file the new app writes "started" into, $5 the process to wait for (or 0), $6
# 1 to open the app afterwards.
SWAP_HELPER = r"""#!/bin/sh
app=$1 copy=$2 old=$3 pending=$4 pid=$5 open=$6
give_up() { rm -rf "$copy"; rm -f "$pending"; exit 1; }
n=0
while [ "$pid" != 0 ] && kill -0 "$pid" 2>/dev/null; do
    n=$((n + 1)); [ $n -gt 120 ] && give_up
    sleep 0.5
done
mv "$app" "$old" || give_up
if ! mv "$copy" "$app"; then mv "$old" "$app"; give_up; fi
[ "$open" = 1 ] && /usr/bin/open "$app"
n=0
while [ $n -lt 60 ]; do
    if grep -q '"started"' "$pending" 2>/dev/null; then rm -rf "$old"; exit 0; fi
    n=$((n + 1)); sleep 0.5
done
# the new one did not start: the old one comes back
/usr/bin/pkill -f "^$app/Contents/MacOS/Protium" 2>/dev/null
mv "$app" "$copy.failed" && mv "$old" "$app"
rm -rf "$copy.failed"
printf '{"failed": "the new version did not start; the old one was put back"}\n' >"$pending"
[ "$open" = 1 ] && /usr/bin/open "$app"
exit 1
"""


def cmd_update_install(image, version, wait_pid):
    """Tests the disk image again, copies its app next to this one, tests the copy, and leaves
    the swap to a helper that outlives this process. Prints "ok installing <version>"."""
    app = this_app()
    if not app:
        return refused("this is a checkout, update it with git")
    folder, current = os.path.dirname(app), protium_version()
    if "/AppTranslocation/" in app or app.startswith("/Volumes/"):
        return refused("Protium is running from a disk image or a temporary copy; move it to Applications first")
    if not os.access(folder, os.W_OK):
        return refused("%s cannot be written by this user, so the app there cannot be replaced" % folder)
    running = games_running(app)
    if running:
        return refused("a game is running from this Protium (%s); quit it first" % os.path.basename(running[0]))
    copy = os.path.join(folder, ".Protium-%s.app" % version)
    old = os.path.join(folder, ".Protium-old.app")
    for leftover in (copy, old):
        if os.path.lexists(leftover):
            shutil.rmtree(leftover, ignore_errors=True)

    def take(found):
        problem = app_problem(found, version, current)
        if problem:
            return problem
        r = subprocess.run(["/usr/bin/ditto", found, copy], stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        return None if r.returncode == 0 else "the app could not be copied: %s" % r.stderr.decode(errors="replace").strip()
    problem = with_image(image, take) or app_problem(copy, version, current)
    if problem:
        shutil.rmtree(copy, ignore_errors=True)
        return refused(problem, image)
    os.makedirs(UPDATE_CACHE, exist_ok=True)
    os.makedirs(HOME_DIR, exist_ok=True)
    helper = os.path.join(UPDATE_CACHE, "swap.sh")
    write_file(helper, SWAP_HELPER)
    write_file(UPDATE_PENDING, json.dumps({"old": current, "new": version}) + "\n")
    subprocess.Popen(["/bin/sh", helper, app, copy, old, UPDATE_PENDING, str(wait_pid),
                      "0" if os.environ.get("PROTIUM_UPDATE_NO_OPEN") else "1"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    if os.path.dirname(os.path.abspath(image)) == UPDATE_CACHE:
        os.remove(image)
    print("ok installing %s" % version)
    return 0


def cmd_steamclient(again):
    import hashlib
    import zipfile
    if not again and all(os.path.isfile(os.path.join(STEAMCLIENT_DIR, d)) for d in STEAMCLIENT_DLLS):
        print("Steam's Windows files are in %s." % STEAMCLIENT_DIR)
        return 0
    manifest = vdf_parse(curl(CLIENT_MANIFEST).decode("utf-8", errors="replace"))
    package = dict((k, v) for k, v in vdf_block(manifest, ["win32", CLIENT_PACKAGE]) if isinstance(v, str))
    name, sha2 = package.get("file"), package.get("sha2", "").lower()
    if not name or not re.fullmatch(r"[A-Za-z0-9_.]+", name) or not re.fullmatch(r"[0-9a-f]{64}", sha2):
        die("Valve's client manifest has no usable %s package" % CLIENT_PACKAGE)
    os.makedirs(STEAMCLIENT_DIR, exist_ok=True)
    zip_path = os.path.join(STEAMCLIENT_DIR, ".%s.zip" % CLIENT_PACKAGE)
    try:
        print("Downloading Steam's Windows files from Valve (%s, %s MB)..." % (name, int(package.get("size", "0")) // 1000000))
        curl(CLIENT_CDN + name, zip_path)
        digest = hashlib.sha256()
        with open(zip_path, "rb") as f:
            for chunk in iter(lambda: f.read(1 << 20), b""):
                digest.update(chunk)
        if digest.hexdigest() != sha2:
            die("%s does not have the SHA-256 Valve's manifest gives" % name)
        with zipfile.ZipFile(zip_path) as z:
            members = {os.path.basename(m).lower(): m for m in z.namelist()}
            for dll in STEAMCLIENT_DLLS:
                if dll.lower() not in members:
                    die("%s has no %s" % (name, dll))
                data = z.read(members[dll.lower()])
                tmp = os.path.join(STEAMCLIENT_DIR, dll + ".steamplay-tmp")
                with open(tmp, "wb") as f:
                    f.write(data)
                os.replace(tmp, os.path.join(STEAMCLIENT_DIR, dll))
                print("%s: %d bytes" % (dll, len(data)))
    finally:
        if os.path.exists(zip_path):
            os.remove(zip_path)
    print("Steam's Windows files are in %s." % STEAMCLIENT_DIR)
    return 0


