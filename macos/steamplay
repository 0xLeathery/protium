DATA_DIR = os.path.join(HOME_DIR, "data")
RESULTS = os.path.join(HOME_DIR, "results.jsonl")
CAPABILITIES = os.path.join(os.path.dirname(os.path.abspath(__file__)), "compat", "capabilities.json")
