# ---- the games list
#
# macos/compat/games.json is the list of games someone has played on Protium and judged, and
# the table under "Status" in the README is written from it, between two marker lines. "result"
# adds or changes a game's entry and writes both, so that the list follows what gets tried; in a
# checkout, the change is then one to commit. Entries can also be edited by hand ("games" writes
# the README again): the first six came from the README as it was.

GAMES = os.path.join(os.path.dirname(os.path.abspath(__file__)), "compat", "games.json")
README = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), ".github", "README.md")
GAMES_START, GAMES_END = "<!-- games: written by \"macos/steamplay games\" from macos/compat/games.json -->", "<!-- games end -->"
VERDICT_TEXT = {"works": "Works", "plays-with-problems": "Plays, with problems",
                "menu-only": "Starts, not played further", "broken": "Does not run"}
API_TEXT = (("d3d12", "Direct3D 12"), ("d3d11", "Direct3D 11"), ("d3d10", "Direct3D 10"), ("d3d9", "Direct3D 9"),
            ("vulkan", "Vulkan"), ("opengl", "OpenGL"))


def game_graphics(appid, cache, runs):
    """"Direct3D 9, 32-bit": the graphics libraries the game loaded in its last recorded run, or,
    for a game that was never run through steamplay-run.sh, the ones its files import."""
    installed = installed_games(cache)
    scan = scans(cache, {appid: installed[appid]}).get(appid, {}) if appid in installed else {}
    loaded = next((r["loaded"] for r in reversed(runs) if r.get("by") == "run" and r.get("loaded")), None)
    apis = set(loaded or scan.get("apis", []))
    if len(apis) > 1:
        apis.discard("opengl")      # Wine loads it for its own windows
    text = " and ".join(name for key, name in reversed(API_TEXT) if key in apis)
    if scan.get("bits") == 32:
        text += ", 32-bit" if text else "32-bit"
    return text


def write_games_table():
    """Writes the README's table from games.json. False when there is no README to write, as in
    the installed app, or it has no marker lines."""
    games = read_json(GAMES, {}).get("games", [])
    try:
        with open(README) as f:
            text = f.read()
    except OSError:
        return False
    if GAMES_START not in text or GAMES_END not in text:
        return False
    order = {v: i for i, v in enumerate(VERDICTS)}
    rows = ["| Game | Graphics | Verdict | Notes | Tested |", "|---|---|---|---|---|"]
    for g in sorted(games, key=lambda g: (order.get(g.get("verdict"), 9), g.get("name", "").lower())):
        cell = lambda v: str(v or "").replace("|", "/").replace("\n", " ")
        rows.append("| %s | %s | %s | %s | %s |" % (cell(g.get("name")), cell(g.get("graphics")),
                                                 VERDICT_TEXT.get(g.get("verdict"), cell(g.get("verdict"))),
                                                 cell(g.get("note")), cell(g.get("tested"))))
    head, rest = text.split(GAMES_START, 1)
    new = head + GAMES_START + "\n" + "\n".join(rows) + "\n" + GAMES_END + rest.split(GAMES_END, 1)[1]
    if new != text:
        write_file(README, new)
    return True


def update_games_list(appid, name, verdict, note, graphics):
    data = read_json(GAMES, {})
    games = data.setdefault("games", [])
    entry = next((g for g in games if g.get("app") == appid), None)
    if entry is None:
        entry = {"app": appid}
        games.append(entry)
    entry.update(name=name, verdict=verdict, tested=time.strftime("%Y-%m-%d"))
    if graphics:
        entry["graphics"] = graphics
    if note or "note" not in entry:
        entry["note"] = note
    try:
        write_file(GAMES, json.dumps(data, indent=1, sort_keys=True, ensure_ascii=False) + "\n")
    except OSError:
        return False
    return write_games_table()


def cmd_games():
    if not write_games_table():
        die("no %s with the games markers to write" % README)
    print("wrote the games table in %s from %s" % (README, GAMES))
    return 0


def outcome(runs):
    """What a game's results say: (good, text), good being True, False or None for "nothing
    conclusive". A verdict someone gave counts before any run, the newest first."""
    for r in reversed(runs):
        if r.get("by") == "user":
            return r["verdict"] in ("works", "plays-with-problems"), "you said: %s%s" % (r["verdict"], (" (%s)" % r["note"]) if r.get("note") else "")
    auto = [r for r in runs if r.get("by") == "run"]
    if not auto:
        return None, ""
    last = auto[-1]
    longest = max(r.get("seconds", 0) for r in auto)
    if last.get("end") in ("abort", "crash") and longest < GOOD_RUN_SECONDS:
        return False, "its last run ended in a %s after %d s" % (last["end"], last.get("seconds", 0))
    # a thread that waited a minute for a lock is not a hung game: Call of Duty: World at War
    # logs it while it plays its cutscenes and takes input
    if last.get("end") == "hang" and longest < GOOD_RUN_SECONDS:
        return None, "in its last run (%d s) a thread waited a minute for a lock, which some games do while running" % last.get("seconds", 0)
    if longest >= GOOD_RUN_SECONDS:
        return True, "it ran for %d minutes" % (longest // 60)
    # a session that is over within a minute and a half of its start, prefix update included,
    # has not shown a game: a crash Wine did not see (Steam's own handler takes native ones)
    if last.get("end") == "ended" and last.get("seconds", 0) < 90:
        return False, "its last run ended by itself after %d s" % last.get("seconds", 0)
    return None, "it ran for %d s at most, which says little" % longest


# ---- the judgement

ORDER = ("Works", "Likely", "Maybe", "Unlikely", "Broken", "Blocked", "Native")
DECK = {3: "Verified", 2: "Playable", 1: "Unsupported"}


def fingerprint(scan):
    """What games built alike share: the engine and the graphics API Protium would use."""
    if not scan:
        return ""
    api = next((a for a in ("d3d11", "d3d12", "d3d9", "d3d10", "vulkan", "opengl") if a in scan.get("apis", [])), "?")
    return "%s/%s" % ((scan.get("engine") or "own engine").split(" ")[0] + (" 5" if scan.get("engine") == "unreal 5" else ""), api)


def judge(appid, app, scan, caps, anticheat, protondb, runs, peers):
    """(verdict, score, reasons) for one game. Blockers first, then what happened when it ran,
    then a score from everything else; each step adds the reason it had."""
    features, reasons = caps["features"], []

    def feature(name, because):
        f = features[name]
        reasons.append("%s: %s" % (because, f["note"]))
        return f.get("score", 0)

    tool, why = rule(app)
    if tool == NATIVE:
        return "Native", 0, [why]
    good, text = outcome(runs)
    tokens = {t for _, t in app["deck_tests"]}
    kernel = [a for a in anticheat.get(appid, []) if a.lower() in {k.lower() for k in caps["kernel_anticheats"]}]
    if kernel or any(t.startswith("UnsupportedAntiCheat") for t in tokens):
        reasons.append("kernel-level anti-cheat (%s): %s" % (", ".join(kernel) or "Valve's Deck test", features["anticheat_kernel"]["note"]))
        return ("Works" if good else "Blocked"), 0, ([text] if good else []) + reasons
    if "SteamOSDoesNotSupport_VR" in tokens:
        return "Blocked", 0, ["a VR game: " + features["vr"]["note"]]
    if good is not None and runs and any(r.get("by") == "user" for r in runs):
        return ("Works" if good else "Broken"), 0, [text]

    score = 0
    if scan:
        apis = scan.get("apis", [])
        usable = [a for a in apis if features[a]["status"] in ("good", "partial")]
        if "d3d11" in apis or "d3d9" in apis or "d3d10" in apis:
            best = next(a for a in ("d3d11", "d3d9", "d3d10") if a in apis)
            score += feature(best, "draws with " + best.replace("d3d", "Direct3D "))
        elif usable:
            score += feature(usable[0], "draws with " + usable[0].replace("d3d", "Direct3D ").replace("vulkan", "Vulkan"))
        elif "opengl" in apis:
            score += feature("opengl", "draws with OpenGL only")
        else:
            reasons.append("no graphics API found in its programs (protected or unusual)")
        if scan.get("engine") == "unreal 5" and "d3d11" not in apis:
            score += feature("unreal5", "Unreal Engine 5 without a Direct3D 11 path")
        elif scan.get("engine"):
            reasons.append("engine: " + scan["engine"])
        if scan.get("dotnet"):
            score += feature("dotnet", "a .NET program")
        if scan.get("anticheat"):
            score += feature("anticheat_files", "ships " + ", ".join(scan["anticheat"]))
        if scan.get("browser"):
            score += feature("embedded_browser", "has an embedded browser")
        if scan.get("bits") == 32:
            reasons.append("32-bit: " + features["x86_32"]["note"])
    else:
        reasons.append("not installed: its files, which name the graphics API and engine, were not read")
    listed = [a for a in anticheat.get(appid, []) if a not in kernel]
    risky = [a for a in listed if "easy anti-cheat" in a.lower() or "battleye" in a.lower()]
    if risky and not (scan and scan.get("anticheat")):
        score += feature("anticheat_files", "uses " + ", ".join(risky))
    other = [a for a in listed if a not in risky and "valve anti-cheat" not in a.lower() and "overlay" not in a.lower()]
    if other:
        reasons.append("anti-cheat of its own (%s): untested here" % ", ".join(other))
    launcher = "LauncherInteractionIssues" in tokens or app.get("thirdparty")
    pdb = protondb.get(str(appid))
    if pdb and pdb[0] >= 5 and pdb[3] / pdb[0] >= 0.5:
        launcher = True
    if launcher:
        score += feature("launcher", "starts through a third-party launcher or account")
    category = app["deck"]
    if category in DECK:
        unsupported_os = "SteamOSDoesNotSupport" in tokens
        score += {3: 2, 2: 1, 1: 0 if unsupported_os else -1}[category]
        reasons.append("Steam Deck: %s%s" % (DECK[category], " (works on Linux Proton)" if category > 1 else ""))
    if tokens & {"DefaultConfigurationIsNotPerformant", "UnsupportedGraphicsPerformance"}:
        score += feature("heavy", "Valve found it slow on the Deck")
    if "SteamOSDoesNotSupport" in tokens:
        score -= 1
        reasons.append("Valve: SteamOS does not support it")
    if pdb and pdb[0] >= 5:
        share = pdb[1] / pdb[0]
        score += 1 if share >= 0.8 else (-2 if share < 0.4 else (-1 if share < 0.6 else 0))
        reasons.append("ProtonDB: %d%% of %d recent reports say it works on Linux" % (round(share * 100), pdb[0]))
    alike_good, alike_bad, kind = peers
    if alike_good or alike_bad:
        score += min(alike_good, 2) - min(alike_bad, 2)
        reasons.append("games built alike (%s): %d ran here, %d did not" % (kind, alike_good, alike_bad))
    if good is True:
        return "Works", score, [text] + reasons
    if good is False:
        return "Unlikely", score, [text] + reasons
    if text:
        reasons.insert(0, text)
    return ("Likely" if score >= 3 else "Maybe" if score >= 1 else "Unlikely"), score, reasons


def discover(only_installed):
    """[(verdict, score, app id, name, installed, reasons)] for the games of this Steam."""
    caps = read_json(CAPABILITIES, None)
    if not caps:
        die("no capability table at %s" % CAPABILITIES)
    cache, runs = app_cache(), results()
    installed = installed_games(cache)
    # a folder counts only while the game is in it: an uninstall leaves saves and crash dumps
    # behind, and a queued download has a record before it has files
    for a, (folder, _) in list(installed.items()):
        launch = cache.get(a, {}).get("launch", [])
        if launch and not any(os.path.isfile(os.path.join(folder, e.replace("\\", "/"))) for e in launch):
            del installed[a]
    try:
        with open(os.path.join(steam_user_config(), "localconfig.vdf"), encoding="utf-8", errors="surrogateescape") as f:
            apps = vdf_block(vdf_parse(f.read()), ["UserLocalConfigStore", "Software", "Valve", "Steam", "apps"])
        known = {int(k) for k, v in apps if k.isdigit()}
    except OSError:
        known = set()
    anticheat = {}
    for g in read_json(os.path.join(DATA_DIR, "anticheat.json"), []):
        steam_id = str(g.get("storeIds", {}).get("steam", ""))
        if steam_id.isdigit():
            anticheat[int(steam_id)] = [a for a in g.get("anticheats", []) if a != "VAC"]
    protondb = read_json(os.path.join(DATA_DIR, "protondb.json"), {}).get("apps", {})
    games = {a: app for a, app in cache.items() if app["type"] in ("game", "demo")
             and (a in installed or (not only_installed and a in known))}
    scanned = scans(cache, {a: v for a, v in installed.items() if a in games and rule(games[a])[0] != NATIVE})
    # what happened to the games built alike, by fingerprint, leaving the game itself out
    by_print = {}
    for a, scan in scanned.items():
        good, _ = outcome(runs.get(a, []))
        if good is not None:
            by_print.setdefault(fingerprint(scan), []).append((a, good))
    out = []
    for a, app in games.items():
        scan = scanned.get(a)
        kind = fingerprint(scan)
        others = [g for b, g in by_print.get(kind, []) if b != a]
        verdict, score, reasons = judge(a, app, scan, caps, anticheat, protondb, runs.get(a, []),
                                        (sum(others), len(others) - sum(others), kind))
        if a in installed and installed[a][1] == "files only":
            reasons.append("its files are in a Steam library, but Steam has no install record of it")
        out.append((verdict, score, a, app["name"], a in installed, reasons))
    out.sort(key=lambda g: (ORDER.index(g[0]), -g[1], g[3].lower()))
    missing = [n for n, p in (("the anti-cheat list", "anticheat.json"), ("ProtonDB", "protondb.json"))
               if not os.path.exists(os.path.join(DATA_DIR, p))]
    return out, missing


def cmd_discover(args):
    why = next((int(a) for a in args if a.isdigit()), None)
    games, missing = discover("--installed" in args)
    if "--json" in args:
        print(json.dumps([{"app": a, "name": n, "verdict": v, "score": s, "installed": i, "reasons": r}
                          for v, s, a, n, i, r in games], indent=1))
        return 0
    if why is not None:
        for v, s, a, n, i, r in games:
            if a == why:
                print("%s (%d): %s, score %d%s" % (n, a, v, s, "" if i else ", not installed"))
                for line in r:
                    print("  - " + line)
                return 0
        die("no game %d among %s" % (why, "the installed games" if "--installed" in args else "this account's games"))
    for verdict in ORDER:
        group = [g for g in games if g[0] == verdict]
        if not group:
            continue
        print("\n%s (%d)" % (verdict, len(group)))
        for v, s, a, n, i, r in group:
            lead = "; ".join([x for x in r if not x.startswith("not installed")][:2]) or (r[0] if r else "")
            print("  %-8d %s %-40s %s" % (a, "*" if i else " ", n[:40], lead[:150]))
    print("\n* installed. \"discover <app id>\" gives every reason for one game.")
    if missing:
        print("Not used, because not downloaded yet (\"data update\" fetches them): " + " and ".join(missing))
    return 0


def cmd_survey(args):
    """Starts each installed game that has no result yet, for a while, and lets the run record
    itself: one game of each kind first, so that few starts say something about many games."""
    if "--away" not in args:
        die("survey starts games on this Mac's screen: run it only while nobody is using the Mac, with --away")
    if not steam_running():
        die("start Steam first: a game asks it who owns it")
    seconds = next((args[i + 1] for i, a in enumerate(args) if a == "--seconds" and i + 1 < len(args)), "240")
    only = {int(a) for a in args[args.index("--only") + 1:] if a.isdigit()} if "--only" in args else None
    games, _ = discover(True)
    runs, kinds, queue = results(), set(), []
    scanned = read_json(os.path.join(DATA_DIR, "scan.json"), {})
    for v, s, a, n, i, r in games:
        if v in ("Native", "Blocked") or (only is not None and a not in only) or (only is None and runs.get(a)):
            continue
        kind = fingerprint(scanned.get(str(a)))
        queue.append((kind in kinds, -s, a, n))
        kinds.add(kind)
    queue.sort()
    limit = next((int(args[i + 1]) for i, a in enumerate(args) if a == "--games" and i + 1 < len(args)), len(queue))
    tried = os.path.join(os.path.dirname(os.path.abspath(__file__)), "steamplay-try")
    for _, _, a, n in queue[:limit]:
        print("== %d %s" % (a, n), flush=True)
        r = subprocess.run([tried, str(a), "--seconds", seconds], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, universal_newlines=True)
        print("\n".join(r.stdout.splitlines()[:3]), flush=True)
        time.sleep(5)
    print("%d game(s) started; \"discover --installed\" shows what changed" % min(limit, len(queue)))
    return 0


