def version_key(text):
    return tuple(int(n) for n in re.findall(r"\d+", text)[:3])


def json_file(path, default):
    try:
        with open(path) as f:
            return json.load(f)
    except (OSError, ValueError):
        return default


def update_check_wanted():
    """The player's choice ("steamplay updates on|off", the app's checkbox); on unless turned off.
    PROTIUM_NO_UPDATE_CHECK=1 turns it off too. Off means no request is ever made."""
    if os.environ.get("PROTIUM_NO_UPDATE_CHECK", "") not in ("", "0"):
        return False
    return json_file(SETTINGS, {}).get("update_check", True) is not False


def fetch_releases():
    """The published releases, newest first: [{"version", "page", "download", "notes"}], notes
    being the release's own changes (its page up to the part every release has). None when
    GitHub cannot be reached. PROTIUM_RELEASES_API may name a file, for the checks."""
    if os.path.isfile(RELEASES_API):
        with open(RELEASES_API) as f:
            text = f.read()
    else:
        r = subprocess.run(["/usr/bin/curl", "-fsSL", "--max-time", "15", "-H", "Accept: application/vnd.github+json", RELEASES_API],
                           stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        if r.returncode != 0:
            return None
        text = r.stdout.decode("utf-8", errors="replace")
    try:
        listed = json.loads(text)
    except ValueError:
        return None
    out = []
    for release in listed if isinstance(listed, list) else []:
        if not isinstance(release, dict) or release.get("draft") or release.get("prerelease"):
            continue
        tag = release.get("tag_name", "")
        if not isinstance(tag, str) or not re.fullmatch(r"v?\d+\.\d+\.\d+", tag):
            continue
        version = tag.lstrip("v")
        page = release.get("html_url", "")
        if not isinstance(page, str) or not page.startswith(RELEASES_PAGE):
            page = RELEASES_PAGE
        # only our own disk image, at the address GitHub serves a release's files from
        download = ""
        for asset in release.get("assets") or []:
            url = asset.get("browser_download_url", "") if isinstance(asset, dict) else ""
            if url == "%sv%s/Protium-%s.dmg" % (RELEASES_DOWNLOAD, version, version):
                download = url
        notes = release.get("body") or ""
        notes = notes.replace("\r\n", "\n").split("\n## Requirements")[0].strip() if isinstance(notes, str) else ""
        out.append({"version": version, "page": page, "download": download, "notes": notes})
    out.sort(key=lambda r: version_key(r["version"]), reverse=True)
    return out


def known_releases(now=False):
    """The releases as GitHub listed them at most a day ago; asks again when the answer is older,
    or with now. [] when the player turned the check off, or nothing is known and GitHub cannot
    be reached."""
    if not update_check_wanted():
        return []
    kept = json_file(UPDATE_CHECK, {})
    fresh = isinstance(kept.get("asked"), (int, float)) and 0 <= time.time() - kept["asked"] < UPDATE_CHECK_SECONDS
    if now or not fresh or kept.get("api") != RELEASES_API:
        releases = fetch_releases()
        if releases is not None:
            kept = {"asked": int(time.time()), "api": RELEASES_API, "releases": releases, "told": kept.get("told", "")}
            os.makedirs(HOME_DIR, exist_ok=True)
            write_file(UPDATE_CHECK, json.dumps(kept, indent=1))
    return kept.get("releases", []) if isinstance(kept.get("releases"), list) else []


def newer_releases(now=False):
    current = protium_version()
    if not current:
        return []
    return [r for r in known_releases(now) if version_key(r["version"]) > version_key(current)]


