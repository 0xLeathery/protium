#!/bin/bash
#
# Start the Windows game Steam hands over, under Protium.
#
#   macos/steamplay-launch <game.exe> [arguments...]
#
# Steam Play's compatibility tool (macos/steamplay-tools/proton-macos/run) calls this when the
# player presses Play, with the game's command line: the Windows executable of the launch entry
# Steam chose, that entry's arguments, and the app id in SteamAppId. So Steam, not this script,
# picks the executable, sees the game as running until it exits and counts its playtime. This
# script hands the executable to macos/steamplay-run.sh, which does the rest (prefix, Valve's
# client DLLs, Proton's steam.exe).
#
# Not started by Steam (no SteamAppId), the app id is the one whose manifest names the install
# folder that holds the executable.

set -euo pipefail

SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
die() { echo "steamplay-launch: error: $*" >&2; exit 1; }

[ $# -ge 1 ] || die 'usage: steamplay-launch <game.exe> [arguments...]'
exe=$1; shift

# Started by Steam, a missing executable is for steamplay-run.sh to tell: it says so in the game's
# log, and what this script says goes nowhere (Steam gives it no output to write to)
appid=${SteamAppId:-}
if [ -z "$appid" ]; then
    [ -f "$exe" ] || die "no executable $exe"
    library=${exe%%/steamapps/common/*}
    rest=${exe#*/steamapps/common/}
    [ "$library" != "$exe" ] || die "$exe is not in a Steam library, and SteamAppId is not set"
    for manifest in "$library"/steamapps/appmanifest_*.acf; do
        if grep -q "\"installdir\"[[:space:]]*\"${rest%%/*}\"" "$manifest"; then
            appid=$(basename "$manifest" .acf); appid=${appid#appmanifest_}
            break
        fi
    done
    [ -n "$appid" ] || die "no app manifest in $library/steamapps for ${rest%%/*}"
fi

GAME_EXE=$exe exec "$SCRIPT_DIR/steamplay-run.sh" "$appid" "$@"
