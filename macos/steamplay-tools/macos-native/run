#!/bin/bash
# Steam Play compatibility tool "macos-native" (installed by macos/steamplay into Steam's
# compatibilitytools.d): a game mapped to it gets its Mac build, which Steam would not choose while
# it takes this Mac for a Linux machine, and runs unchanged. See macos/steamplay.
LOG=${STEAMPLAY_TOOL_LOG:-/Users/annon/projects/proton-macos-build/evidence/steamplay/probe.log}
# what Steam asked for, for diagnosis (not the account's name, which Steam also passes)
{ echo "=== $(date '+%F %T') macos-native argv: $*"; echo "cwd: $(pwd)"
  env | grep -E '^(STEAM_COMPAT|STEAM_DYLD|SteamAppId|SteamGameId)' | sort; } >> "$LOG" 2>/dev/null
verb=${1:-}; shift || true
case $verb in
    waitforexitandrun|run)
        # a Mac game's launch entry is its app bundle: start the program inside it, so that it
        # keeps the environment Steam gives a game (its app id among it)
        if [ -d "${1:-}" ] && [ -f "$1/Contents/Info.plist" ]; then
            app=$1; shift
            exe=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$app/Contents/Info.plist" 2>/dev/null)
            [ -n "$exe" ] && [ -x "$app/Contents/MacOS/$exe" ] && exec "$app/Contents/MacOS/$exe" "$@"
            exec /usr/bin/open -W -a "$app" --args "$@"
        fi
        exec "$@" ;;
    *) exit 0 ;;
esac
