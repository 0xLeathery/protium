#!/bin/bash
# Steam Play compatibility tool "proton-macos" (installed by macos/steamplay into Steam's
# compatibilitytools.d): Steam runs "<this> <verb> <game command...>" for a game mapped to it, and
# this hands the Windows game to the macOS Proton build. See macos/steamplay.
PROTON_DIR=${PROTON_DIR:-/Users/annon/projects/Proton/macos}
LOG=${STEAMPLAY_TOOL_LOG:-/Users/annon/projects/proton-macos-build/evidence/steamplay/probe.log}
{ echo "=== $(date '+%F %T') proton-macos argv: $*"; echo "cwd: $(pwd)"
  env | grep -E '^(STEAM|Steam|SteamApp|DYLD)' | sort; } >> "$LOG" 2>/dev/null
verb=${1:-}; shift || true
case $verb in
    waitforexitandrun|run) exec "$PROTON_DIR/steamplay-launch" "$@" ;;
    *) exit 0 ;;    # getcompatpath, getnativepath and the like: nothing to translate
esac
