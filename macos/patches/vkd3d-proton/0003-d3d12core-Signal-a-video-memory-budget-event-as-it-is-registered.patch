d3d12core: Signal a video memory budget event as it is registered.

Windows signals the event passed to
IDXGIAdapter3::RegisterVideoMemoryBudgetChangeNotificationEvent once at
registration, and DXVK's DXGI does the same ("This method seems to fire the
event immediately on Windows"). Red Dead Redemption 2 depends on it: after it
has tried out its D3D12 devices it registers an event and, on its main thread,
waits for it without a timeout before it makes its window.

DXMT's DXGI, which this build uses, takes the registration and returns S_OK
without ever signalling the event, so the game sat with no window until the
Rockstar launcher was closed. DXMT does not take AI-written code, so the fix
is not made there: d3d12core wraps the method on the adapter a device is made
from, and signals the event after the DXGI's own method has succeeded. The
wrapper is put in when the first device is made, which is before Red Dead
registers its event. A Direct3D 11 program that waits the same way is not
covered by this; that takes the one line in DXMT itself.

Applied by macos/build-vkd3d-proton.sh to github.com/athei/vkd3d-proton at
c5e2c9b8c55872893e3ba47d60448dd4f35185ef. Written with an AI assistant
(Claude); vkd3d-proton states no policy on that.
---
diff --git a/libs/d3d12core/main.c b/libs/d3d12core/main.c
index fa299e33..1dc1c887 100644
--- a/libs/d3d12core/main.c
+++ b/libs/d3d12core/main.c
@@ -640,6 +640,49 @@ static HRESULT vkd3d_create_instance_global(struct vkd3d_instance **out_instance
     return hr;
 }
 
+#ifdef _WIN32
+/* Windows signals a video memory budget event once as it is registered, and DXVK's DXGI does the
+ * same. An application may wait for that before it goes on: Red Dead Redemption 2 does, on its
+ * main thread, before it makes its window. A DXGI that only takes note of the registration
+ * leaves it waiting for good, so the adapter's method is wrapped to signal the event as well. */
+static HRESULT (STDMETHODCALLTYPE *dxgi_register_budget_event)(IUnknown *adapter, HANDLE event, DWORD *cookie);
+
+static HRESULT STDMETHODCALLTYPE d3d12_register_budget_event(IUnknown *adapter, HANDLE event, DWORD *cookie)
+{
+    HRESULT hr = dxgi_register_budget_event(adapter, event, cookie);
+
+    if (SUCCEEDED(hr) && event)
+        SetEvent(event);
+    return hr;
+}
+
+static void d3d12_wrap_budget_event_registration(IDXGIAdapter *dxgi_adapter)
+{
+    static const GUID adapter3_iid = {0x645967a4, 0x1392, 0x4310, {0xa7, 0x98, 0x80, 0x53, 0xce, 0x3e, 0x93, 0xfd}};
+    /* IDXGIAdapter3::RegisterVideoMemoryBudgetChangeNotificationEvent */
+    static const unsigned int method_index = 16;
+    IUnknown *adapter3;
+    void **slot, *method;
+    DWORD protect;
+
+    if (FAILED(IDXGIAdapter_QueryInterface(dxgi_adapter, &adapter3_iid, (void **)&adapter3)))
+        return;
+
+    /* One DXGI is wrapped, the first one seen. The method is read once, so that two threads
+     * that get here together keep the same one. */
+    slot = &(*(void ***)adapter3)[method_index];
+    method = *slot;
+    if (method != (void *)d3d12_register_budget_event && !dxgi_register_budget_event
+            && VirtualProtect(slot, sizeof(*slot), PAGE_READWRITE, &protect))
+    {
+        dxgi_register_budget_event = method;
+        *slot = (void *)d3d12_register_budget_event;
+        VirtualProtect(slot, sizeof(*slot), protect, &protect);
+    }
+    IUnknown_Release(adapter3);
+}
+#endif
+
 static HRESULT STDMETHODCALLTYPE d3d12core_CreateDeviceFromFactory(
         IUnknown *adapter, D3D_FEATURE_LEVEL minimum_feature_level,
         ID3D12DeviceFactory *factory,
@@ -674,6 +717,8 @@ static HRESULT STDMETHODCALLTYPE d3d12core_CreateDeviceFromFactory(
     if (FAILED(hr = d3d12_get_adapter(&dxgi_adapter, adapter)))
         return hr;
 
+    d3d12_wrap_budget_event_registration(dxgi_adapter);
+
     if (FAILED(hr = IDXGIAdapter_GetDesc(dxgi_adapter, &adapter_desc)))
     {
         WARN("Failed to get adapter desc, hr %#x.\n", (int)hr);
