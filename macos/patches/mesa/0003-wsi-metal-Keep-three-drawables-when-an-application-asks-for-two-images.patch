@@ -243,7 +243,16 @@
       metal_layer.allowsNextDrawableTimeout = YES;
       metal_layer.framebufferOnly = framebuffer_only;
 
-      metal_layer.maximumDrawableCount = image_count;
+      /* Three drawables whatever the image count. The surface reports a
+       * minimum of 3 images, but an application may ask for fewer all the same
+       * (DOOM 2016 asks for 2), and with 2 drawables one is always on screen:
+       * nextDrawable then cannot return before the frame just presented has
+       * been drawn and shown, so drawing and showing run one after the other
+       * and a FIFO frame takes whole refreshes more than its work (20 fps
+       * where the same scene runs at 90 unsynchronised). The images the
+       * application sees are not the drawables: each acquire binds whichever
+       * drawable nextDrawable returns to the next image. */
+      metal_layer.maximumDrawableCount = image_count < 3 ? 3 : image_count;
       metal_layer.drawableSize = (CGSize){.width = width, .height = height};
       metal_layer.opaque = enable_opaque;
