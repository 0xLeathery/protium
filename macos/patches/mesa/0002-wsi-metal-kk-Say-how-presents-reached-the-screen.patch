+
+#define SAY(...) do { \
+      if (pos < (int)sizeof(line)) \
+         pos += snprintf(line + pos, sizeof(line) - pos, __VA_ARGS__); \
+   } while (0)
+#define MS(sum, count) ((count) ? (sum) * 1e3 / (count) : 0.0)
+
+   SAY("MESA: info: KosmicKrisp: presents of the last %.0f s (%s, %s): %u presents, ",
+       seconds, util_get_process_name(), at, wsi_metal_stats.presents);
+   if (wsi_metal_stats.paced)
+      SAY("%u of them paced at %u Hz, ", wsi_metal_stats.paced, wsi_metal_stats.refresh_rate);
+   else
+      SAY("not paced, ");
+   SAY("%u shown, %u not shown, %u let go by Metal, %u without a drawable; ",
+       wsi_metal_stats.shown, wsi_metal_stats.unshown, wsi_metal_stats.dropped,
+       wsi_metal_stats.no_drawable);
+   SAY("from present to the screen %.1f ms (most %.1f ms), %.1f ms of it after the GPU was done (%u known); ",
+       MS(wsi_metal_stats.to_screen, wsi_metal_stats.to_screen_count),
+       wsi_metal_stats.to_screen_max * 1e3,
+       MS(wsi_metal_stats.after_gpu, wsi_metal_stats.after_gpu_count),
+       wsi_metal_stats.after_gpu_count);
+   SAY("shown refreshes apart:");
+   for (uint32_t i = 0; i <= WSI_METAL_STATS_GAPS; i++) {
+      if (wsi_metal_stats.gaps[i])
+         SAY(" %u%s x %u", i, i == WSI_METAL_STATS_GAPS ? " or more" : "", wsi_metal_stats.gaps[i]);
