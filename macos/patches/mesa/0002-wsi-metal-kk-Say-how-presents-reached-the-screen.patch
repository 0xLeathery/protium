+/* Present statistics, for finding where a frame's time goes between the
+ * application and the screen. KK_PRESENT_STATS=<seconds> turns them on: after
+ * that many seconds of presents, one line goes to stderr. They are one set
+ * for the process, as a game has one window. Times from Metal (presentedTime,
+ * the GPU's start and end of a command buffer) and from the layer code are
+ * CACurrentMediaTime() seconds. */
+#define WSI_METAL_STATS_GAPS 12
+#define WSI_METAL_STATS_RING 16
+
+static struct {
+   simple_mtx_t mutex;
+   int interval;        /* seconds; 0: off; -1: not read yet */
+   /* What runs across lines: the last shown present, the end of the GPU's
+    * last command buffer, the screen's rate, and the GPU's end of the last
+    * command buffers that present a drawable. */
+   double last_shown, gpu_last_end;
+   uint32_t refresh_rate;
+   struct {
+      void *drawable;
+      double gpu_end;
+   } done[WSI_METAL_STATS_RING];
+   uint32_t done_next;
+
+   /* What a line counts; all of it starts again with the next line. */
+   double start;        /* when this line's time began; 0 before a present */
+   uint32_t presents, paced, hidden;
+   uint32_t shown, unshown, dropped, no_drawable;
+   /* From the present call to presentedTime, and how much of that came
+    * after the GPU had finished the command buffer that presents it. */
+   double to_screen, to_screen_max, after_gpu;
+   uint32_t to_screen_count, after_gpu_count;
+   /* Shown presents by how many refreshes after the one before they were
+    * shown; the last entry is for more. */
+   uint32_t gaps[WSI_METAL_STATS_GAPS + 1];
+   uint32_t acquires, acquire_timeouts, acquire_no_drawable;
+   double acquire_wait, acquire_wait_max;
+   uint32_t fetches, fetch_nil;
+   double fetch_time, fetch_max;
+   /* The union of the command buffers' GPU intervals. A feedback handler
+    * that comes after a later buffer's is counted as late, its time lost. */
+   double gpu_busy;
+   uint32_t gpu_buffers, gpu_late;
+   uint32_t held_most, swapchains_made, swapchains_gone;
+} wsi_metal_stats = {
+   .mutex = SIMPLE_MTX_INITIALIZER,
+   .interval = -1,
+};
+
+bool
+wsi_metal_stats_enabled(void)
+{
+   int interval = p_atomic_read(&wsi_metal_stats.interval);
+   if (interval < 0) {
+      const char *option = os_get_option("KK_PRESENT_STATS");
+      interval = option ? MAX2(atoi(option), 0) : 0;
+      p_atomic_set(&wsi_metal_stats.interval, interval);
+   }
+   return interval > 0;
+}
+
+void
+wsi_metal_stats_note_fetch(double seconds, bool got_drawable)
+{
+   simple_mtx_lock(&wsi_metal_stats.mutex);
+   wsi_metal_stats.fetches++;
+   if (!got_drawable)
+      wsi_metal_stats.fetch_nil++;
+   wsi_metal_stats.fetch_time += seconds;
+   wsi_metal_stats.fetch_max = MAX2(wsi_metal_stats.fetch_max, seconds);
+   simple_mtx_unlock(&wsi_metal_stats.mutex);
+}
+
+void
+wsi_metal_stats_note_gpu(void *drawable, double gpu_start, double gpu_end)
+{
+   if (gpu_end <= 0.0 || gpu_end < gpu_start)
+      return;
+
+   simple_mtx_lock(&wsi_metal_stats.mutex);
+   wsi_metal_stats.gpu_buffers++;
+   if (gpu_end <= wsi_metal_stats.gpu_last_end) {
+      wsi_metal_stats.gpu_late++;
+   } else {
+      wsi_metal_stats.gpu_busy +=
+         gpu_end - MAX2(gpu_start, wsi_metal_stats.gpu_last_end);
+      wsi_metal_stats.gpu_last_end = gpu_end;
+   }
+   if (drawable) {
+      const uint32_t slot = wsi_metal_stats.done_next++ % WSI_METAL_STATS_RING;
+      wsi_metal_stats.done[slot].drawable = drawable;
+      wsi_metal_stats.done[slot].gpu_end = gpu_end;
+   }
+   simple_mtx_unlock(&wsi_metal_stats.mutex);
+}
+
+void
+wsi_metal_stats_note_presented(void *drawable, double queued_time,
+                               double presented_time)
+{
+   if (presented_time <= 0.0)
+      return;
+
+   simple_mtx_lock(&wsi_metal_stats.mutex);
+   const double to_screen = presented_time - queued_time;
+   wsi_metal_stats.to_screen += to_screen;
+   wsi_metal_stats.to_screen_max = MAX2(wsi_metal_stats.to_screen_max, to_screen);
+   wsi_metal_stats.to_screen_count++;
+   for (uint32_t i = 0; i < WSI_METAL_STATS_RING; i++) {
+      if (wsi_metal_stats.done[i].drawable != drawable)
+         continue;
+      if (presented_time >= wsi_metal_stats.done[i].gpu_end) {
+         wsi_metal_stats.after_gpu += presented_time - wsi_metal_stats.done[i].gpu_end;
+         wsi_metal_stats.after_gpu_count++;
+      }
+      wsi_metal_stats.done[i].drawable = NULL;
+      break;
+   }
+   if (wsi_metal_stats.last_shown > 0.0 && wsi_metal_stats.refresh_rate) {
+      const double refreshes = (presented_time - wsi_metal_stats.last_shown) *
+                               wsi_metal_stats.refresh_rate;
+      const uint32_t gap = refreshes < 0.5 ? 0 :
+         MIN2((uint32_t)(refreshes + 0.5), WSI_METAL_STATS_GAPS);
+      wsi_metal_stats.gaps[gap]++;
+   }
+   wsi_metal_stats.last_shown = presented_time;
+   simple_mtx_unlock(&wsi_metal_stats.mutex);
+}
+
+static void
+wsi_metal_stats_note_acquire(uint64_t wait_ns, VkResult result, bool got_drawable)
+{
+   const double wait = wait_ns / 1e9;
+
+   simple_mtx_lock(&wsi_metal_stats.mutex);
+   wsi_metal_stats.acquires++;
+   if (result != VK_SUCCESS)
+      wsi_metal_stats.acquire_timeouts++;
+   else if (!got_drawable)
+      wsi_metal_stats.acquire_no_drawable++;
+   wsi_metal_stats.acquire_wait += wait;
+   wsi_metal_stats.acquire_wait_max = MAX2(wsi_metal_stats.acquire_wait_max, wait);
+   simple_mtx_unlock(&wsi_metal_stats.mutex);
+}
+
+/* A present ended: shown (presented_time above 0), let go unshown (0) or
+ * released by Metal without a word (below 0); or it had no drawable. */
+static void
+wsi_metal_stats_note_end(double presented_time, bool had_drawable)
+{
+   simple_mtx_lock(&wsi_metal_stats.mutex);
+   if (!had_drawable)
+      wsi_metal_stats.no_drawable++;
+   else if (presented_time > 0.0)
+      wsi_metal_stats.shown++;
+   else if (presented_time == 0.0)
+      wsi_metal_stats.unshown++;
+   else
+      wsi_metal_stats.dropped++;
+   simple_mtx_unlock(&wsi_metal_stats.mutex);
+}
+
+static void
+wsi_metal_stats_note_swapchain(bool made)
+{
+   simple_mtx_lock(&wsi_metal_stats.mutex);
+   if (made)
+      wsi_metal_stats.swapchains_made++;
+   else
+      wsi_metal_stats.swapchains_gone++;
+   simple_mtx_unlock(&wsi_metal_stats.mutex);
+}
