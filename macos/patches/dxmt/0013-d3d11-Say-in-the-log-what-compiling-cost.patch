diff --git a/src/d3d11/d3d11_pipeline.hpp b/src/d3d11/d3d11_pipeline.hpp
--- a/src/d3d11/d3d11_pipeline.hpp
+++ b/src/d3d11/d3d11_pipeline.hpp
@@ -175,6 +175,19 @@ public:
   virtual void GetPipeline(MTL_COMPILED_TESSELLATION_MESH_PIPELINE *pTessellationPipeline) = 0;
 };
 
+// The pipeline for a draw or a dispatch, on the encoding thread, which waits here when it is not
+// made yet: such a wait is counted with its time (a pipeline that is there costs one test more)
+template <typename Pipeline, typename Compiled>
+void
+GetPipelineForDraw(Pipeline *pso, Compiled *compiled) {
+  if (pso->GetIsDone()) {
+    pso->GetPipeline(compiled);
+    return;
+  }
+  CompileTimer timer(compile_counters.draw_waits, compile_counters.draw_wait_ns);
+  pso->GetPipeline(compiled);
+}
