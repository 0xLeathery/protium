+// What compiling costs, for the frame recorder's line (d3d11_swapchain.cpp): the shaders compiled
+// from Direct3D's bytecode and those read from the shader cache, the pipelines Metal made of
+// them, and the draws that had to wait for their pipeline, each with its time. One set for the
+// process, defined in d3d11_pipeline_cache.cpp: this is d3d11.dll's alone.
+struct CompileCounters {
+  std::atomic<uint64_t> shaders{0}, shader_ns{0}, cached_shaders{0}, cached_shader_ns{0}, pipelines{0},
+      pipeline_ns{0}, draw_waits{0}, draw_wait_ns{0};
+  const std::chrono::steady_clock::time_point since = std::chrono::steady_clock::now();
+};
+extern CompileCounters compile_counters;
+
+// Counts one, and the time from where it is made to where it goes out of scope
+class CompileTimer {
+public:
+  CompileTimer(std::atomic<uint64_t> &count, std::atomic<uint64_t> &ns)
+      : count_(&count), ns_(&ns), start_(std::chrono::steady_clock::now()) {}
+  CompileTimer(const CompileTimer &) = delete;
+  CompileTimer &operator=(const CompileTimer &) = delete;
+  ~CompileTimer() {
+    count_->fetch_add(1, std::memory_order_relaxed);
+    ns_->fetch_add(
+        std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now() - start_).count(),
+        std::memory_order_relaxed);
+  }
+  // to count as another kind than the one it was made for
+  void into(std::atomic<uint64_t> &count, std::atomic<uint64_t> &ns) {
+    count_ = &count;
+    ns_ = &ns;
+  }
+
+private:
+  std::atomic<uint64_t> *count_, *ns_;
+  std::chrono::steady_clock::time_point start_;
+};
