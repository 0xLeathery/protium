+  // "1 shader" and "2 shaders"
+  static const char *Many(uint64_t count, const char *one, const char *many) { return count == 1 ? one : many; }
+
+  // What compiling cost since the line before: the shaders compiled and those read from the
+  // shader cache, the pipelines Metal made, and the draws that waited for theirs. The counts are
+  // the process's (d3d11_shader.hpp), so this is one line for all its swap chains, written by
+  // the one whose half minute is up or that goes, and only when there was something to count.
+  static void SayCompiles(const std::string &head) {
+    struct Said {
+      dxmt::mutex mutex;
+      frame_clock::time_point when = compile_counters.since;
+      uint64_t shaders = 0, shader_ns = 0, cached = 0, cached_ns = 0, pipelines = 0, pipeline_ns = 0, waits = 0,
+               wait_ns = 0;
+    };
+    static Said said;
+    std::lock_guard<dxmt::mutex> lock(said.mutex);
+    auto now = frame_clock::now();
+    auto read = [](const std::atomic<uint64_t> &counter) { return counter.load(std::memory_order_relaxed); };
+    // a time before its count: a count that is seen has its time in the sum or in the next line's
+    uint64_t shader_ns = read(compile_counters.shader_ns), cached_ns = read(compile_counters.cached_shader_ns),
+             pipeline_ns = read(compile_counters.pipeline_ns), wait_ns = read(compile_counters.draw_wait_ns);
+    uint64_t shaders = read(compile_counters.shaders), cached = read(compile_counters.cached_shaders),
+             pipelines = read(compile_counters.pipelines), waits = read(compile_counters.draw_waits);
+    double seconds = std::chrono::duration<double>(now - said.when).count();
+    said.when = now;
+    if (shaders == said.shaders && cached == said.cached && pipelines == said.pipelines && waits == said.waits)
+      return;
+    char text[640];
+    snprintf(text, sizeof(text),
+             "DXGI: compiles of the last %.0f s%s: %llu %s compiled (%.0f ms), %llu from the shader cache (%.0f ms), "
+             "%llu %s (%.0f ms), %llu %s waited for a pipeline (%.1f ms); so far %llu %s compiled, %llu from the "
+             "shader cache, %llu %s, draws waited %.1f ms",
+             seconds, head.c_str(), (unsigned long long)(shaders - said.shaders),
+             Many(shaders - said.shaders, "shader", "shaders"), (shader_ns - said.shader_ns) / 1e6,
+             (unsigned long long)(cached - said.cached), (cached_ns - said.cached_ns) / 1e6,
+             (unsigned long long)(pipelines - said.pipelines), Many(pipelines - said.pipelines, "pipeline", "pipelines"),
+             (pipeline_ns - said.pipeline_ns) / 1e6, (unsigned long long)(waits - said.waits),
+             Many(waits - said.waits, "draw", "draws"), (wait_ns - said.wait_ns) / 1e6, (unsigned long long)shaders,
+             Many(shaders, "shader", "shaders"), (unsigned long long)cached, (unsigned long long)pipelines,
+             Many(pipelines, "pipeline", "pipelines"), wait_ns / 1e6);
+    Logger::info(text);
+    said.shaders = shaders;
+    said.shader_ns = shader_ns;
+    said.cached = cached;
+    said.cached_ns = cached_ns;
+    said.pipelines = pipelines;
+    said.pipeline_ns = pipeline_ns;
+    said.waits = waits;
+    said.wait_ns = wait_ns;
+  }
