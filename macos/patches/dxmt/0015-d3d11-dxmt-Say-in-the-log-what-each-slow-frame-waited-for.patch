+  // What a slow frame waited for, said as it is noticed, for the first 24 of a half minute. The
+  // frame is the time from the Present before to this one, on the thread that presents. Of it:
+  // the waits for an earlier frame (that Present's, for the frame the queue's latency makes it
+  // wait for and for the one the swap chain's does), the waits for the GPU and the query flushes
+  // the game made, the waits for a free command chunk; the rest is the game's own time and
+  // DXMT's on this thread. Then what was compiled meanwhile, and what the frame that was waited
+  // for cost on the encoding thread and on the GPU: it is the newest one known to be done.
+  double carry_earlier_ms_ = 0, carry_commit_ms_ = 0;
+  uint64_t frame_pipelines_ = 0, frame_shaders_ = 0;
+
+  void SaySlowFrame(double ms) {
+    auto &queue = device_->GetDXMTDevice().queue();
+    const FrameStatistics &frame = queue.CurrentFrameStatistics();
+    auto to_ms = [](clock::duration d) { return std::chrono::duration<double, std::milli>(d).count(); };
+    double earlier = to_ms(frame.present_latency_interval) + carry_earlier_ms_;
+    double gpu_wait = to_ms(frame.sync_interval), commit = to_ms(frame.commit_interval) + carry_commit_ms_;
+    uint64_t pipelines = compile_counters.pipelines.load(std::memory_order_relaxed) - frame_pipelines_;
+    uint64_t shaders = compile_counters.shaders.load(std::memory_order_relaxed) - frame_shaders_;
+    char text[1000]; /* with "info:  " and the newline, under Wine's 1020 bytes a line */
+    int used = snprintf(
+        text, sizeof(text),
+        "DXGI: slow frame%s: %.1f ms: %.1f ms for an earlier frame, %u %s for the GPU (%.1f ms), %u query %s, "
+        "commit %.1f ms, rest %.1f ms; %llu new %s, %llu %s compiled",
+        Head(true).c_str(), ms, earlier, frame.sync_count, Many(frame.sync_count, "wait", "waits"), gpu_wait,
+        frame.event_stall, Many(frame.event_stall, "flush", "flushes"), commit,
+        std::max(0.0, ms - earlier - gpu_wait - commit), (unsigned long long)pipelines,
+        Many(pipelines, "pipeline", "pipelines"), (unsigned long long)shaders, Many(shaders, "shader", "shaders"));
+    // The Present before waited until the frame "latency" frames before it was done on the GPU:
+    // that frame's numbers are final, unless its place among the kept frames has been taken
+    uint64_t current = queue.CurrentFrameSeq() - 1;
+    uint32_t latency = queue.GetMaxLatency();
+    if (current > latency && used > 0 && used < int(sizeof(text))) {
+      if (latency + 1 < kFrameStatisticsCount) {
+        const FrameStatistics &done = queue.statistics.at(current - latency - 1);
+        snprintf(text + used, sizeof(text) - used,
+                 "; the frame %u before: encoding %.1f ms (%.1f ms of it for %u %s, %.1f ms for a drawable), GPU "
+                 "%.1f ms",
+                 latency + 1, to_ms(done.encode_prepare_interval + done.encode_flush_interval),
+                 to_ms(done.pipeline_wait_interval), done.pipeline_wait_count,
+                 Many(done.pipeline_wait_count, "pipeline", "pipelines"), to_ms(done.drawable_blocking_interval),
+                 to_ms(done.gpu_interval));
+      } else {
+        snprintf(text + used, sizeof(text) - used, "; the frame %u before: not kept", latency + 1);
+      }
+    }
+    Logger::info(text);
+  }
+
   void SayFrameTimes(const std::string &head) const {
     if (!frame_count_)
       return;
