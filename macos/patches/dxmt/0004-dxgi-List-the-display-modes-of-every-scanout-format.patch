+/*
+ * The formats a display can be driven in, whether or not Metal can present
+ * them: Wine's own DXGI and DXVK list the display's modes for each of these.
+ * B8G8R8X8 has no Metal backbuffer, but a game may still ask for the modes in
+ * it, and one that gets none offers no resolutions.
+ */
+bool IsMonitorFormat(DXGI_FORMAT Format) {
+  switch (Format) {
+  case DXGI_FORMAT_R8G8B8A8_UNORM:
+  case DXGI_FORMAT_B8G8R8A8_UNORM:
+  case DXGI_FORMAT_B8G8R8X8_UNORM:
+  case DXGI_FORMAT_R8G8B8A8_UNORM_SRGB:
+  case DXGI_FORMAT_B8G8R8A8_UNORM_SRGB:
+  case DXGI_FORMAT_B8G8R8X8_UNORM_SRGB:
+  case DXGI_FORMAT_R10G10B10A2_UNORM:
+  case DXGI_FORMAT_R10G10B10_XR_BIAS_A2_UNORM:
+  case DXGI_FORMAT_R16G16B16A16_FLOAT:
+    return true;
+  default:
+    return false;
+  }
+}
+
+/*
+ * Logs, the first time for each format in a process, which display modes were
+ * asked for and how many were found: a game that finds none may offer no
+ * resolutions, or crash when it looks one up.
+ */
+void LogModeQuery(DXGI_FORMAT Format, UINT Flags, UINT Count) {
+  static std::atomic<uint64_t> seen[4];
+  uint32_t format = uint32_t(Format);
+  if (format >= 256)
+    return;
+  uint64_t bit = uint64_t(1) << (format % 64);
+  if (seen[format / 64].fetch_or(bit) & bit)
+    return;
+  Logger::info(str::format("DXGI: display modes of format ", format, " (flags ", Flags, "): ", Count));
+}
