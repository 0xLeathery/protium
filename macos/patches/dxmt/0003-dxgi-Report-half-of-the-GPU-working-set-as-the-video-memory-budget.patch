+  // The budget a game plans its use of video memory by. With unified memory that is the
+  // memory of the whole system, and recommendedMaxWorkingSetSize, the most the GPU should
+  // hold, is three quarters of it: a game that fills it leaves too little for itself and the
+  // system, which then compresses and swaps (Call of Duty: WWII grew to 18 GB on a 24 GB Mac
+  // and its frame rate fell from 120 to under 50). So it is the DedicatedVideoMemory the
+  // adapter reports, half of that. DXMT_VIDEO_MEMORY_BUDGET_MB sets it.
+  uint64_t videoMemoryBudget() {
+    std::string value = env::getEnvVar("DXMT_VIDEO_MEMORY_BUDGET_MB");
+    if (!value.empty()) {
+      uint64_t mb = strtoull(value.c_str(), nullptr, 10);
+      if (mb)
+        return mb << 20;
+    }
+    if (device_.hasUnifiedMemory())
+      return device_.recommendedMaxWorkingSetSize() / 2;
+    return device_.recommendedMaxWorkingSetSize();
   }
 
