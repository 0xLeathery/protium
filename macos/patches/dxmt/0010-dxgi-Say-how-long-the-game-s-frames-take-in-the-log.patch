     // A sync interval above 0 waits for the display's vertical blank, as on Windows, unless the
     // game allows tearing; dxgi.syncInterval replaces the game's interval when it is set
@@ -1359,6 +1366,65 @@
   WMT::Object native_view_;
   WMT::MetalLayer layer_weak_;
   ULONG presentation_count_;
+
+  // How long the game's frames take: the time from one Present to the next, counted in steps
+  // of half a millisecond up to 200 ms. Said in the log every half minute and when the swap
+  // chain goes, each time for the whole run so far, so that the last line stands for the run
+  // also when the game is ended from outside. A clock read and a count per frame.
+  using frame_clock = std::chrono::steady_clock;
+  static constexpr size_t kFrameSteps = 400;
+  std::array<uint32_t, kFrameSteps> frame_steps_{};
+  uint64_t frame_count_ = 0;
+  uint64_t frame_slow_ = 0;
+  double frame_worst_ms_ = 0;
+  double frame_total_ms_ = 0;
+  frame_clock::time_point frame_last_{};
+  frame_clock::time_point frame_said_{};
+
+  void NoteFrame() {
+    auto now = frame_clock::now();
+    if (frame_last_ != frame_clock::time_point{}) {
+      double ms = std::chrono::duration<double, std::milli>(now - frame_last_).count();
+      frame_steps_[std::min(size_t(ms * 2.0), kFrameSteps - 1)]++;
+      frame_count_++;
+      frame_total_ms_ += ms;
+      if (ms > 50.0)
+        frame_slow_++;
+      if (ms > frame_worst_ms_)
+        frame_worst_ms_ = ms;
+    }
+    if (frame_said_ == frame_clock::time_point{})
+      frame_said_ = now;
+    frame_last_ = now;
+    if (now - frame_said_ >= std::chrono::seconds(30)) {
+      frame_said_ = now;
+      SayFrameTimes();
+    }
+  }
+
+  // the frame time that the given share of the frames stayed under
+  double FrameTimeAt(double share) const {
+    uint64_t wanted = uint64_t(double(frame_count_) * share), seen = 0;
+    for (size_t i = 0; i < kFrameSteps; i++) {
+      seen += frame_steps_[i];
+      if (seen > wanted)
+        return i == kFrameSteps - 1 ? frame_worst_ms_ : double(i + 1) / 2.0;
+    }
+    return frame_worst_ms_;
+  }
+
+  void SayFrameTimes() const {
+    if (!frame_count_)
+      return;
+    char text[200];
+    snprintf(text, sizeof(text),
+             "DXGI: frame times: %llu frames in %llu s, median %.1f ms, 95%% %.1f ms, 99%% %.1f ms, "
+             "worst %.1f ms, %llu over 50 ms",
+             (unsigned long long)frame_count_, (unsigned long long)(frame_total_ms_ / 1000.0), FrameTimeAt(0.50),
+             FrameTimeAt(0.95), FrameTimeAt(0.99), frame_worst_ms_, (unsigned long long)frame_slow_);
+    Logger::info(text);
+  }
+
   DXGI_SWAP_CHAIN_DESC1 desc_;
   // Whether desc_.Width and desc_.Height are ResolveBufferSize's 8x8 fallback
   bool width_fallback_ = false;
