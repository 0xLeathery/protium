diff --git a/FEXCore/Source/Interface/Core/LookupCache.cpp b/FEXCore/Source/Interface/Core/LookupCache.cpp
index 4518a2a9e..dd83da1a5 100644
--- a/FEXCore/Source/Interface/Core/LookupCache.cpp
+++ b/FEXCore/Source/Interface/Core/LookupCache.cpp
@@ -76,8 +76,10 @@ LookupCache::LookupCache(FEXCore::Context::ContextImpl* CTX)
 }
 
 LookupCache::~LookupCache() {
-  FEXCore::Allocator::VirtualFree(reinterpret_cast<void*>(CacheBase), TotalCacheSize);
+  // Before the memory is freed: once it is, the cache of a thread that is starting can be given the same address and
+  // mark the same range, which this would then unmark.
   ctx->SyscallHandler->UnmarkOvercommitRange(CacheBase, TotalCacheSize);
+  FEXCore::Allocator::VirtualFree(reinterpret_cast<void*>(CacheBase), TotalCacheSize);
 
   // No need to free BlockLinks map.
   // These will get freed when their memory allocators are deallocated.
