--- a/Source/Windows/UnixLib/FEXUnixLib.cpp
+++ b/Source/Windows/UnixLib/FEXUnixLib.cpp
@@ -177,7 +177,13 @@ static inline void* InitializeSHM(uint32_t MapSize, uint32_t MaxSize, uint64_t M
     return nullptr;
   }
 
+#ifdef __APPLE__
+  // macOS lets the size of a shared memory object be set once only, so it gets its full size here.
+  // Its pages cost nothing until they are written.
+  if (ftruncate(fd, MaxSize) == -1) {
+#else
   if (ftruncate(fd, MapSize) == -1) {
+#endif
     goto err;
   }
 
@@ -229,9 +235,11 @@ static inline bool AllocateMoreSlots(void* SHMBase, uint32_t NewSize) {
     return false;
   }
 
+#ifndef __APPLE__
   if (ftruncate(fd, NewSize) == -1) {
     goto err;
   }
+#endif
 
   {
     auto SharedBase = mmap(SHMBase, NewSize, PROT_READ | PROT_WRITE, MAP_SHARED | MAP_FIXED, fd, 0);
