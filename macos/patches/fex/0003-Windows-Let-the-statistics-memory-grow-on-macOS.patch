diff --git a/Source/Windows/Common/SHMStats.cpp b/Source/Windows/Common/SHMStats.cpp
index 498fc2cda..ec177817e 100644
--- a/Source/Windows/Common/SHMStats.cpp
+++ b/Source/Windows/Common/SHMStats.cpp
@@ -21,8 +21,8 @@ uint32_t StatAlloc::FrontendAllocateSlots(uint32_t NewSize) {
 
   auto Result = UnixLib::AllocateSHMSlots(Base, std::min(NewSize, MAX_STATS_SIZE), MAX_STATS_SIZE);
 
-  // Return the new size allocated, if it happened to change.
-  return Result.MappedSize;
+  // Return the new size allocated, if it happened to change. A failed call reports no size at all.
+  return Result.SHMBase ? Result.MappedSize : CurrentSize;
 }
 
