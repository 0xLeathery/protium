diff --git a/Source/Windows/Common/HardwareTSO.h b/Source/Windows/Common/HardwareTSO.h
index b399f1cd2..8366fdd6d 100644
--- a/Source/Windows/Common/HardwareTSO.h
+++ b/Source/Windows/Common/HardwareTSO.h
@@ -39,6 +39,11 @@ bool Init();
 // Whether threads are switched individually, which requires the hooks in this file.
 bool PerThread();
 
+// Whether a thread is switched off before native code handles a guest syscall, and a unix call. The host decides
+// (FEX_HARDWARE_TSO_OFF on macOS). A thread that is not switched off stays on until it ends.
+bool LeaveForSyscalls();
+bool LeaveForUnixCalls();
+
 // Sets the state of a new thread.
 void InitThread(FEXCore::Core::CpuStateFrame* Frame);
 
diff --git a/Source/Windows/UnixLib/FEXUnixLib.cpp b/Source/Windows/UnixLib/FEXUnixLib.cpp
index c4440f7dc..d8ebb540b 100644
--- a/Source/Windows/UnixLib/FEXUnixLib.cpp
+++ b/Source/Windows/UnixLib/FEXUnixLib.cpp
@@ -107,9 +107,26 @@ static FEXUnixLib_HardwareTSOProbeResult ProbeHardwareTSO() {
   return FEXUnixLib_HardwareTSOProbeResult::Available;
 }
 
+// FEX_HARDWARE_TSO_OFF says for which calls a thread leaves hardware TSO: "all" (also when unset or unknown),
+// "syscall", "unix" or "none".
+static uint32_t HardwareTSOLeave() {
+  const char* Env = getenv("FEX_HARDWARE_TSO_OFF");
+  if (Env && !strcmp(Env, "none")) {
+    return 0;
+  }
+  if (Env && !strcmp(Env, "syscall")) {
+    return FEXUNIXLIB_HARDWARE_TSO_LEAVE_SYSCALL;
+  }
+  if (Env && !strcmp(Env, "unix")) {
+    return FEXUNIXLIB_HARDWARE_TSO_LEAVE_UNIXCALL;
+  }
+  return FEXUNIXLIB_HARDWARE_TSO_LEAVE_SYSCALL | FEXUNIXLIB_HARDWARE_TSO_LEAVE_UNIXCALL;
+}
+
 static NTSTATUS FEXUnixLib_ProbeHardwareTSOHandler(void* _Args) {
   auto Args = reinterpret_cast<FEXUnixLib_ProbeHardwareTSOArgs*>(_Args);
   Args->Result = ProbeHardwareTSO();
+  Args->Leave = HardwareTSOLeave();
   Args->Trap = Args->Result == FEXUnixLib_HardwareTSOProbeResult::Available ? GetHardwareTSOTrapNumber() : 0;
   return STATUS_SUCCESS;
 }
diff --git a/Source/Windows/UnixLib/FEXUnixLib.h b/Source/Windows/UnixLib/FEXUnixLib.h
index 214cbc1fd..80c25bdd9 100644
--- a/Source/Windows/UnixLib/FEXUnixLib.h
+++ b/Source/Windows/UnixLib/FEXUnixLib.h
@@ -96,11 +96,19 @@ enum class FEXUnixLib_HardwareTSOProbeResult : uint32_t {
   Unavailable,
 };
 
+// A thread that stays on for a call saves the two traps around it (about 190ns on an M4), and the native code of that
+// call then runs under TSO, where code that mostly stores is slower.
+enum FEXUnixLib_HardwareTSOLeave : uint32_t {
+  FEXUNIXLIB_HARDWARE_TSO_LEAVE_SYSCALL = 1,
+  FEXUNIXLIB_HARDWARE_TSO_LEAVE_UNIXCALL = 2,
+};
+
 struct FEXUnixLib_ProbeHardwareTSOArgs {
   // Out: the Mach trap number of thread_set_x86_64_compat, which PE code issues directly with svc #0x80 to switch
   // the calling thread.
   int64_t Trap;
   FEXUnixLib_HardwareTSOProbeResult Result;
-  uint32_t pad;
+  // Out: which calls into native code a thread leaves hardware TSO for, FEXUnixLib_HardwareTSOLeave bits.
+  uint32_t Leave;
 };
 static_assert(sizeof(FEXUnixLib_ProbeHardwareTSOArgs) == 16, "Must match between the PE and unix sides");
